#!/bin/sh
# Re-generate external executable cmd macros:
# different platforms may have different full/realpaths
# fatal error. Print message to stdout then quit with exitval
err() {
	exitval=$1
	shift
	echo "$*" 1>&2
	exit ${exitval}
}

cleanup() {
	rm -f "${CMD_FILE}.tmp"
}

[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
# MAIN
if [ -z "${workdir}" ]; then
	[ -z "${cbsd_workdir}" ] && . /etc/rc.conf
	[ -z "${cbsd_workdir}" ] && exit 0
	workdir="${cbsd_workdir}"
fi

[ ! -f "${CIX_DISTDIR}/cbsd.conf" ] && exit 0

export CIX_INITENV=1
. "${CIX_DISTDIR}/cbsd.conf"
unset CIX_INITENV

if [ -z "${workdir}" -o "${workdir}" = "(null)" ]; then
	. /etc/rc.conf
	[ -z "${cbsd_workdir}" ] && exit 0
	workdir="${cbsd_workdir}"
fi

CMD_FILE="${workdir}/cmd.subr"

PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"
[ -z "${platform}" ] && platform=$( uname -s )
[ "${platform}" = "NetBSD" ] && PATH="${PATH}:/usr/pkg/bin"

if [ -n "${PRE_CBSD_CMD_PATH}" ]; then
	PATH="${PRE_CBSD_CMD_PATH}:${PATH}"
fi
if [ -n "${POST_CBSD_CMD_PATH}" ]; then
	PATH="${PATH}:${POST_CBSD_CMD_PATH}"
fi

export PATH

trap cleanup EXIT INT TERM

# main cmd: generic command for all platform
