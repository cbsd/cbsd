#!/usr/local/bin/cbsd
#v12.1.14
# Script for create or upgrade SQLite tables by known scheme from sh file
# Usage: ./updatesql <dbfile> <schema_file> <tablename>
NOCOLOR=0
# get CBSD path
if [ -z "${CIX_DISTDIR}" ]; then
	echo "updatesql: empty CIX_DISTDIR"
	exit 1
fi
. ${CIX_DISTDIR}/cbsd.conf
. ${subrdir}/nc.subr

# fatal error. Print message to stdout then quit with exitval
err() {
	exitval=$1
	shift
	echo "$*" 1>&2
	exit ${exitval}
}


create_table()
{
	local _newtable= _n= _i= _val=

	_newtable="CREATE TABLE IF NOT EXISTS ${MYTABLE} ( "
	_n=0

	for _i in ${MYCOL}; do
		eval _val=\$$_i
		[ ${_n} -ne 0 ] && _newtable="${_newtable},"
		_newtable="${_newtable} ${_i} ${_val}"
		_n=$(( _n + 1 ))
	done

	_newtable="${_newtable} ${CONSTRAINT} )"

	cbsdsqlrw ${MYFILE} "${_newtable}"
}

update_table()
{
	local _i= _val= _res=

	for _i in ${MYCOL}; do
		eval _val=\$$_i
		capture _res cbsdsqlro ${MYFILE} "SELECT COUNT(*) FROM pragma_table_info('${MYTABLE}') WHERE name = '${_i}';"
		[ "${_res}" != "1" ] && cbsdsqlrw ${MYFILE} "ALTER TABLE ${MYTABLE} ADD COLUMN ${_i} ${_val}"
	done

	[ -n "${INITDB}" ] && cbsdsqlrw ${MYFILE} "${INITDB}"
}

## MAIN ##
[ $# -ne 3 ] && err 1 "Usage $0 <dbfile> <path_to_schema> <tablename>"

MYFILE="${1}"
SCHEMA="${2}"
MYTABLE="${3}"

capture DIRNAME dirname ${MYFILE}
[ ! -d ${DIRNAME} ] && err 1 "updatesql: no such dir: ${DIRNAME}"

[ ! -f ${MYFILE} ] && touch ${MYFILE}
chmod 0660 ${MYFILE} && chown ${cbsduser}:${cbsduser} ${MYFILE}

[ ! -f ${SCHEMA} ] && err 1 "File ${SCHEMA} not found"

. ${SCHEMA}

[ -z "${MYCOL}" ] && err 1 "updatesql: empty MYCOL in schema: ${SCHEMA}"
[ -z "${MYTABLE}" ] && err 1 "updatesql: No MYTABLE variable"

create_table
update_table

exit 0
