#!/bin/sh
# Scenario:
#  chech for: grep -E '^[^#]+#'
pgm="${0##*/}"			# Program basename
progdir="${0%/*}"		# Program directory

set -e
. ${progdir}/../config.conf
set +e

[ "${PROFILES_TEST_ENABLE}" != "1" ] && exit 0

oneTimeSetUp()
{
	PROFILES_COUNT=0

	PROFILES=$( find ${CIX_DISTDIR}/etc/defaults/ -mindepth 1 -maxdepth 1 -type f -name vm-\*.conf -exec basename {} \; 2>/dev/null | xargs )
	assertNotNull "PROFILES is empty or unset" "$PROFILES"

	for i in ${PROFILES}; do
		PROFILES_COUNT=$(( PROFILES_COUNT + 1 ))
	done
}

testComments()
{
	local _broken_profiles=
	local _first=1 _cmd=

	echo "Profiles count: ${PROFILES_COUNT}"
	for i in ${PROFILES}; do
		grep -E '^[^#]+#' ${CIX_DISTDIR}/etc/defaults/${i}
		_ret=$?
		assertEquals "comments not on a new line, check: grep -E '^[^#]+#' ${CIX_DISTDIR}/etc/defaults/${i}" 1 "${_ret}"
	done
}

. ${progdir}/../shunit2
