#!/usr/bin/env cbsd
#v11.0.6
CIXARG=""
CIXOPTARG="test"
MYDESC="Unit tests for /usr/local/cbsd/subr/tools.subr"
ADDHELP="Usage: cbsd subr_tools.subr [test=FUNCTION_NAME]"

. ${subrdir}/nc.subr

cixinit

# cixinit parses key=value args but does not consume positional params.
# Clear them so shunit2 (sourced later) sees $#=0 and enters SOURCED mode.
set --

. ${tools}

# ============================================================
# Test functions for /usr/local/cbsd/subr/tools.subr
# Each test_XXX function tests the XXX function from tools.subr.
# To add a new test: define test_XXX() using shunit2 assertions.
# ============================================================

# Stub templates - not yet implemented, return 0 (pass) silently
test_is_special_ip() { return 0; }
test_iptype() { return 0; }
test_resolvhost() { return 0; }
test_conv2bytes() { return 0; }
test_conv2human() { return 0; }
test_first_ips_w_mask() { return 0; }
test_mask2cdr() { return 0; }
test_cdr2mask() { return 0; }
test_validate_hwaddr() { return 0; }
test_node_state() { return 0; }
test_conv_time() { return 0; }
test_select_jail_by_list() { return 0; }
test_prepare_offline_jail() { return 0; }
test__randompw_pipeline() { return 0; }
test_random_password_gen() { return 0; }
test_jname_is_multiple() { return 0; }
test_get_bytes() { return 0; }
test_rotate_lease_file() { return 0; }
test_fn_exists() { return 0; }
test_cbsd_lock() { return 0; }
test_get_file_bytes() { return 0; }
test_get_file_blocks() { return 0; }
test_kernel_mod() { return 0; }

# ---- MAC address generation ----

test_mac_gen()
{
	local _mac= _mac2= _rc= _colon_count=

	# Generate MAC with valid OUI - should succeed and produce output
	capture _mac mac_gen 02:ff:f0
	_rc=$?
	assertNotNull "mac_gen with OUI 02:ff:f0 returns non-empty result" "${_mac}"
	assertTrue "mac_gen exit code is 0" "[ ${_rc} -eq 0 ]"

	# Result matches MAC address format: xx:xx:xx:xx:xx:xx (lowercase hex)
	echo "${_mac}" | grep -qE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$'
	assertTrue "MAC matches format xx:xx:xx:xx:xx:xx" $?

	# OUI prefix (first 3 octets) is preserved from input
	echo "${_mac}" | grep -q '^02:ff:f0:'
	assertTrue "OUI prefix 02:ff:f0 is preserved in output" $?

	# MAC has exactly 6 colon-separated octets (= 5 colons)
	_colon_count=$( echo "${_mac}" | awk -F: '{print NF}' )
	assertEquals "MAC has 6 octets" "6" "${_colon_count}"

	# mac_gen without OUI returns error (exit code 1)
	mac_gen 2>/dev/null
	assertFalse "mac_gen without OUI returns error" $?

	# mac_gen with empty OUI returns error
	mac_gen "" 2>/dev/null
	assertFalse "mac_gen with empty OUI returns error" $?

	# Different OUI prefix works correctly
	capture _mac2 mac_gen 00:a0:98
	assertNotNull "mac_gen with OUI 00:a0:98 returns result" "${_mac2}"
	echo "${_mac2}" | grep -q '^00:a0:98:'
	assertTrue "OUI prefix 00:a0:98 is preserved" $?

	# Generate 3 MAC addresses and verify all are unique
	local _mac_list= _dupe_count=
	_mac_list=$( mac_gen 02:ff:f0 3 )
	_dupe_count=$( echo "${_mac_list}" | sort | uniq -d | wc -l )
	assertEquals "3 generated MACs are all unique" "0" "${_dupe_count}"
}

# ---- shunit2 integration ----

# suite() controls which tests to execute.
# Called by shunit2 when sourced without CLI test names.
# When $test is set (from cbsd subr_tools.subr test=mac_gen),
# only that test runs. Otherwise shunit2 auto-discovers via SHUNIT_PARENT.
suite()
{
	if [ -n "${test}" ]; then
		suite_addTest "test_${test}"
	fi
	# When $test is empty: suite() adds nothing, shunit2 auto-discovers all test_*
}

# Validate test= parameter before sourcing shunit2
if [ -n "${test}" ]; then
	if ! command -v "test_${test}" >/dev/null 2>&1; then
		echo "ERROR: function test_${test}() not found in $( basename "${0}" )"
		exit 1
	fi
fi

# Help shunit2 locate test functions in this file ($0 resolves to script path)
SHUNIT_PARENT="${0}"

. /usr/local/cbsd/tests/shunit2
