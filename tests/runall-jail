#!/bin/sh
pgm="${0##*/}"                  # Program basename
progdir="${0%/*}"               # Program directory

set -e
. ${progdir}/config.conf
set +e

[ ! -d "${CIX_DISTDIR}/tests/jail" ] && exit 0

JAIL_TESTS=$( cd ${CIX_DISTDIR}/tests/jail && ls -1 *.sh | sort -h )

all_tests=0
for i in ${JAIL_TESTS}; do
	all_tests=$(( all_tests + 1 ))
done

cur_test=0

for i in ${JAIL_TESTS}; do
	cur_test=$(( cur_test + 1 ))
	echo "JAIL TESTS: [${cur_test}/${all_tests}] --- ${i} ---"
	cd ${CIX_DISTDIR}/tests/jail && ./${i}
	ret=$?
	if [ ${ret} -ne 0 ]; then
		echo "FAILED: ${i}"
		exit ${ret}
	fi
done

exit 0
