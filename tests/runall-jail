#!/bin/sh
pgm="${0##*/}"                  # Program basename
progdir="${0%/*}"               # Program directory

set -e
. ${progdir}/config.conf
set +e

JAIL_TESTS=$( test -d "${CIX_DISTDIR}/tests/jail" && find ${CIX_DISTDIR}/tests/jail/ -type f -name *.sh | sort )

all_tests=0
for i in ${ALL_TESTS}; do
	all_tests=$(( all_tests + 1 ))
done

cur_test=0

for i in ${ALL_TESTS}; do
	cur_test=$(( cur_test + 1 ))
	echo "JAIL TESTS: [${cur_test}/${all_tests}] --- ${i} ---"
	${i}
	ret=$?
	if [ ${ret} -ne 0 ]; then
		echo "FAILED: ${i}"
		exit ${ret}
	fi
done

exit 0
