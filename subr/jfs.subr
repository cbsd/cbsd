if [ ! "$_CBSD_JFS_SUBR" ]; then
_CBSD_JFS_SUBR=1
###

. ${subrdir}/zfs.subr

# Move data directory from $1 to $2, handling ZFS mountpoint changes.
# For ZFS: re-mount or create dataset at new path.
# For non-ZFS: simple mv.
mvdata()
{
	local _src= _dst= _ret= _res= _zfsfeat= _realsrc=
	[ -z "$1" ] || [ -z "$2" ] && err 1 "mvdata: empty arguments"

	_src=${1}
	_dst=${2}

	[ -d "${_dst}" ] && err 1 "${_dst} directory exist. Please remove them first"

	# is symlink? in this case zfsfeat=0, just move symlink
	if [ -h "${_src}" ]; then
		_zfsfeat=0
	else
		_zfsfeat="${zfsfeat}"
	fi

	if [ "${_zfsfeat}" = "0" ]; then
		${MV_CMD} ${_src} ${_dst}
		_ret=$?
		return ${_ret}
	fi

	capture _realsrc ${REALPATH_CMD} "${_src}"
	zfsmnt "${_realsrc}"
	_res=$?

	readconf zfs.conf

	case "${_res}" in
		0)
			${ECHO} "Switch to ZFS pool"
			zfsmnt "${workdir}"
			${ZFS_CMD} create ${zfs_create_flags} -o mountpoint="${_dst}" "${ZPOOL}${_dst}"
			${ZFS_CMD} mount "${ZPOOL}${_dst}"
			${MKDIR_CMD} "${_dst}"
			cd "${_src}" && ${PAX_CMD} -p eme -rw . "${_dst}"
			[ "${platform}" != "Linux" ] && ${CHFLAGS_CMD} -R noschg "${_src}"
			${RM_CMD} -rf "${_src}"
			;;
		1)
			${ZFS_CMD} umount -f "${_src}" > /dev/null 2>&1
			${ZFS_CMD} set mountpoint="${_dst}" "${ZPOOL}"
			${ZFS_CMD} mount "${ZPOOL}"
			${RMDIR_CMD} "${_src}"
			;;
		2)
			${ZFS_CMD} set mountpoint="${_dst}" "${ZPOOL}"
			${ZFS_CMD} mount "${ZPOOL}"
			${RMDIR_CMD} "${_src}"
			;;
	esac

	return 0
}

# Clone environment data from source to destination.
# -d <path> - destination dir
# -f - force (skip dir existence check)
# -m <mode> - cp, rsync, rsyncforce, zfs, zfspromote
# -o <oldjname> - old jail name for path replacement
# -n <new_name> - clone/snapshot name (default: $jname)
# -p <promote> - promote ZFS dataset (0 or 1)
# -s <path> - source dir
clonedata()
{
	local _src= _dst= _mode= _go= _force= _zpool= _name=
	local _dskname= _res= _jname= _orig_mode= _old_jname= _orig_data=
	local _new_data= _createtime= _imgbytes= _new_zvol= _feat= _def_val=
	local _zvol_opts= _new_name= _promote=

	_force=0

	while getopts "d:fj:m:n:o:p:s:" opt; do
		case "${opt}" in
			d) _dst="${OPTARG}" ;;
			f) _force=1 ;;
			m) _mode="${OPTARG}" ;;
			n) _new_name="${OPTARG}" ;;
			o) _old_jname="${OPTARG}" ;;
			p) _promote="${OPTARG}" ;;
			s) _src="${OPTARG}" ;;
		esac
		shift $(( OPTIND - 1 ))
	done

	[ -z "${_dst}" ] && log_err 1 "${N1_COLOR}clonedata: empty ${N2_COLOR}dst${N0_COLOR}"
	[ -z "${_mode}" ] && log_err 1 "${N1_COLOR}clonedata: empty ${N2_COLOR}mode${N0_COLOR}"
	[ -z "${_src}" ] && log_err 1 "${N1_COLOR}clonedata: empty ${N2_COLOR}src${N0_COLOR}"
	[ -z "${jname}" ] && log_err 1 "${N1_COLOR}clonedata: no jname${N0_COLOR}"
	[ -z "${_new_name}" ] && _new_name="${jname}"
	[ -z "${_promote}" ] && _promote="0"

	# save original clone method
	_orig_mode="${_mode}"

	[ -d "${_dst}" ] && [ ${_force} -eq 0 ] && log_err 1 "${N1_COLOR}clonedata: ${N2_COLOR}${_dst}${N1_COLOR} directory exist. Please remove them${N0_COLOR}"

	readconf zfs.conf

	# check for ZFS clone possibility and create snapshot
	case "${_mode}" in
		zfs|zfspromote)
			[ ${zfsfeat} -ne 1 ] && log_err 1 "${N1_COLOR}clonedata: zfs clone method but zfsfeat=0${N0_COLOR}"
			[ -z "${_new_name}" ] && log_err 1 "${N1_COLOR}clonedata: empty -n new_name of the snapshot${N0_COLOR}"

			zfsmnt "${_src}"
			_res=$?
			case "${_res}" in
				0)
					# not valid ZFS mp, force non-zfs clone method
					cbsdlogger NOTICE ${CIX_APP}: force to rsync clone method, not ZFS mount point: ${_src}
					${ECHO} "${N1_COLOR}Force to rsync clone method, not ZFS mount point: ${N2_COLOR}${_src}${N0_COLOR}"
					_mode="rsync"
					;;
				1|2)
					capture _orig_data ${ZFS_CMD} get -Ho value name "${_src}" 2>/dev/null
					if [ -z "${_orig_data}" ]; then
						${ECHO} "${N1_COLOR}${_src} is not ZFS dataset, force to rsync clone method${N0_COLOR}"
						cbsdlogger NOTICE ${CIX_APP}: ${_src} is not ZFS dataset, force to rsync clone method
						_mode="rsync"
					else
						if [ -n "${_old_jname}" ]; then
							capture _new_data ${SED_CMD} "s:/${_old_jname}:/${_new_name}:g" <<< "${_orig_data}"
						else
							_new_data="${_orig_data}"
						fi
						cbsdlogger NOTICE ${CIX_APP}: clonedata: zfs snapshot ${_orig_data}@cbsd-original-${_new_name}
						${ZFS_CMD} snapshot ${_orig_data}@cbsd-original-${_new_name}
						${ZFS_CMD} set cbsdsnap:jname=${_new_name} ${_orig_data}@cbsd-original-${_new_name}
						${ZFS_CMD} set cbsdsnap:snapname="${_new_data}" ${_orig_data}@cbsd-original-${_new_name}

						create_zfs_fs -d "${_src}" -m "${_dst}" -n "${_new_name}" -p ${_promote} -z "${_orig_data}@cbsd-original-${_new_name}"
					fi
					;;
				*)
					log_err 1 "${N1_COLOR}clonedata: unknown code for: zfsmnt ${_src}${N0_COLOR}"
					;;
			esac
	esac

	case "${_mode}" in
		cp|rsync)
			_go="/usr/local/bin/rsync -avzz --devices --numeric-ids --delete --recursive --partial "
			;;
		"rsyncforce")
			_go="/usr/local/bin/rsync -avzz --devices --numeric-ids --delete --recursive --partial "
			_force=1
			;;
		zfs|zfspromote)
			[ -z "${_new_name}" ] && log_err 1 "${N1_COLOR}clonedata: empty -n name of the snapshot${N0_COLOR}"
			unset _go
			;;
		*)
			log_err 1 "clonedata: unsupported mode: ${_mode}"
			;;
	esac

	cbsdlogger NOTICE ${CIX_APP}: clonedata mode selected: ${_mode}

	# create directory and copy data via rsync/copy method
	if [ -n "${_go}" ]; then
		if [ ! -d "${_dst}" ]; then
			if [ ${zfsfeat} -eq 1 ]; then
				capture _zpool ${ZFS_CMD} get -Ho value name "${jaildatadir}"
				${ZFS_CMD} create ${zfs_create_flags} -o mountpoint=${_dst} ${_zpool}/${jname}
				. ${system}	# for is_mounted
				if ! is_mounted ${_zpool}/${jname}; then
					cbsdlogger NOTICE ${CIX_APP}: zfs not mounted, mount: ${_zpool}/${jname}
					${ZFS_CMD} mount ${_zpool}/${jname}
				fi
			else
				${MKDIR_CMD} -p ${_dst}
			fi
		fi

		cbsdlogger NOTICE ${CIX_APP}: clonedata: ${_go} ${_src}/* ${_dst}/
		${_go} ${_src}/ ${_dst}/
	fi

	# additional loop to check for symlink and zvol
	if [ ${zfsfeat} -eq 1 ]; then
		for _i in $( ${FIND_CMD} ${_dst}/ -mindepth 1 -maxdepth 1 -type l ); do
			if is_getzvol ${_i}; then
				capture _dskname ${BASENAME_CMD} "${_i}"
				capture _imgbytes ${ZFS_CMD} get -Hp -o value volsize ${is_zvol}
				capture _new_zvol ${SED_CMD} "s:/${_old_jname}/:/${_new_name}/:g" <<< "${is_zvol}"

				case "${_orig_mode}" in
					zfs|zfspromote)
						cbsdlogger NOTICE ${CIX_APP}: clonedata: create zfs snapshot: ${is_zvol}@cbsd-original-${_new_name}-${_dskname}
						${ZFS_CMD} snapshot ${is_zvol}@cbsd-original-${_new_name}-${_dskname}
						${ZFS_CMD} set cbsdsnap:jname=${_new_name} ${is_zvol}@cbsd-original-${_new_name}-${_dskname}
						${ZFS_CMD} set cbsdsnap:snapname="${_new_data}" ${is_zvol}@cbsd-original-${_new_name}-${_dskname}
						cbsdlogger NOTICE ${CIX_APP}: clonedata: clone zfs snapshot: ${is_zvol}@cbsd-original-${_new_name}-${_dskname} to ${_new_zvol}
						${ZFS_CMD} clone -o volmode=dev -p ${is_zvol}@cbsd-original-${_new_name}-${_dskname} ${_new_zvol}
						;;
					*)
						_zvol_opts=
						# lookup for "default_vm_zvol_*" defaults
						for _feat in ${default_vm_zvol_managed_feature}; do
							eval _def_val="\$default_vm_zvol_${_feat}"
							if [ -n "${_def_val}" ]; then
								if [ -z "${_zvol_opts}" ]; then
									_zvol_opts="-o ${_feat}=${_def_val}"
								else
									_zvol_opts="${_zvol_opts} -o ${_feat}=${_def_val}"
								fi
							fi
						done

						${ZFS_CMD} create -V ${_imgbytes} ${_zvol_opts} ${_new_zvol}
						# Linux does not support postfix in bs=, e.g. bs=1g
						case "${platform}" in
							Linux)
								${DD_CMD} if=/dev/zvol/${is_zvol} of=/dev/zvol/${_new_zvol} bs=1024000000
								;;
							*)
								${DD_CMD} if=/dev/zvol/${is_zvol} of=/dev/zvol/${_new_zvol} bs=1024000000
								;;
						esac
						;;
				esac
				cbsdlogger NOTICE ${CIX_APP}: clonedata: create ${_i} symlink to ZVOL: /dev/zvol/${_new_zvol}
				${LN_CMD} -sf /dev/zvol/${_new_zvol} ${_i}
			fi
		done
	fi

	capture _res ${FIND_CMD} ${_dst}/ -mindepth 1 -maxdepth 1 -name "dsk*.vhd" \( -type l -or -type f \)

	for _i in ${_res}; do
		_dskname="${_i##*/}"
		[ -z "${_dskname}" ] && continue
		media mode=register name="hdd-${_dskname}" path="${_i}" type="hdd" jname="${jname}" 2>/dev/null
	done
}

# Remove data directory from disk, unmounting if needed.
# Returns 1 if removal failed.
removedir()
{
	local _data= data=

	[ -z "${1}" ] && err 1 "removedir: empty arguments"
	data="${1}"
	# not dir and not link?
	[ ! -d "${data}" ] && [ ! -h "${data}" ] && return 0
	capture _data ${REALPATH_CMD} "${data}"
	[ ! -d "${_data}" ] && return 0
	# determine if ${_data} is mountpoint and try to remove content inside dir first,
	# then - unmount and rmdir
	. ${system}		# is_mounted func
	if is_mounted "${_data}"; then
		# mounted: remove dirs, files, then unmount and remove mountpoint
		${NICE_CMD} -n 19 ${IDLE_IONICE} ${FIND_CMD} ${_data}/ -mindepth 1 -maxdepth 1 -type d -exec ${RM_CMD} -rf {} \;
		${NICE_CMD} -n 19 ${IDLE_IONICE} ${FIND_CMD} ${_data}/ -mindepth 1 -maxdepth 1 -exec ${RM_CMD} -f {} \;
		${UMOUNT_CMD} -f ${_data}
		${RM_CMD} -rf ${_data}
	else
		# not a mount, unset schg first
		[ "${platform}" != "Linux" ] && ${NICE_CMD} -n 19 ${IDLE_IONICE} ${CHFLAGS_CMD} -R noschg ${_data}
		${RM_CMD} -rf ${_data}
	fi

	[ -h "${data}" ] && ${RM_CMD} -f ${data}
	[ -d "${data}" ] && ${RMDIR_CMD} ${data}
	[ -d "${_data}" ] || [ -d "${data}" ] && return 1
	return 0
}

# Remove environment data directory, destroying ZFS/hammer datasets.
# $jname must be set by caller.
remove_data_dir()
{
	local _data= _res= _jaildatadir= _ZPOOL= _jailfs=
	local _retry= _max_retry= data= _ret= _i=

	[ -z "${1}" ] && err 1 "remove_data_dir: empty arguments"
	[ -z "${jname}" ] && err 1 "remove_data_dir: jname variable must be set"

	data="${1}"

	capture _data ${REALPATH_CMD} ${data}

	[ ! -d "${_data}" ] && return 0

	if [ "${zfsfeat}" = "1" ]; then
		case "${emulator}" in
			bhyve|xen|qemu)
				for _i in $( ${FIND_CMD} ${_data}/ -mindepth 1 -maxdepth 1 -type l ); do
					if is_getzvol ${_i}; then
						${ZFS_CMD} destroy ${is_zvol}
					fi
					${RM_CMD} -f ${_i}
				done
				;;
			*)
				;;
		esac
		# extra check if zfs still exist
		capture _jaildatadir ${REALPATH_CMD} ${jaildatadir}
		capture _ZPOOL ${ZFS_CMD} get -Ho value name ${_jaildatadir}
		if [ -n "${_ZPOOL}" ]; then
			case "${emulator}" in
				bhyve|xen|qemu)
					_jailfs="${_ZPOOL}/bcbsd-${jname}-dsk1.vhd ${_ZPOOL}/${jname}"		# back compatible for CBSD <=12.0.14
					for _i in ${_jailfs}; do
						for _try in 1 2 3; do
							# workaround for dataset busy, give the pause with three attempts
							${ZFS_CMD} list ${_i} >/dev/null 2>/dev/null
							if [ $? -eq 0 ]; then
								sleep 1
								${ZFS_CMD} destroy ${_i} > /dev/null 2>&1
							fi
						done
					done
					;;
				*)
					;;
			esac
			unmountdata ${_data}
			${ZFS_CMD} list ${_ZPOOL}/${jname} >/dev/null 2>/dev/null
			if [ $? -eq 0 ]; then
				# sometimes these errors happen:
				# cannot unmount 'XXX': pool or dataset is busy
				# needs some timeout/retry
				_retry=0
				_max_retry=4
				. ${system}     # for is_mounted
				while [ ${_retry} -lt ${_max_retry} ]; do
					if is_mounted ${_data}; then
						${UMOUNT_CMD} -f ${_data} 2>/dev/null
					fi
					${ZFS_CMD} destroy ${_ZPOOL}/${jname}
					${ZFS_CMD} list ${_ZPOOL}/${jname} >/dev/null 2>/dev/null
					[ $? -ne 0 ] && break
					${ECHO} "${N1_COLOR}${CIX_APP}: cannot destroy ${_ZPOOL}/${jname} (${_data}), retry: ${N2_COLOR}${_retry}/${_max_retry}${N0_COLOR}" 1>&2
					sleep 1
					_retry=$(( _retry + 1 ))
				done
			fi
		fi
	elif [ "${hammerfeat}" = "1" ]; then
		destroy_hammer_fs ${jname}
	fi
	# remove directory
	removedir ${data}
	_ret=$?

	if [ ${_ret} -ne 0 ]; then
		if [ "${mod_cbsd_redis_enabled}" = "YES" ] && [ -z "${MOD_CBSD_REDIS_DISABLED}" ]; then
			cbsdredis publish cbsd_events '{"cmd":"jremove", "node":"'${nodename}'", "jail":"'${jname}'", "status":-1}'
		fi
		err 1 "${N1_COLOR}Directory not empty or busy: ${_data}${N0_COLOR}"
	fi
	return 0
}

# Unmount ZFS dataset at $1 if it is a mounted mountpoint.
unmountdata()
{
	local _data= _OZPOOL= _res=

	[ -z "$1" ] && err 1 "unmountdata: no arguments"
	_data="$1"

	[ ! -d "${_data}" ] && return 1

	# store and restore old ZPOOL value after zfsmnt
	_OZPOOL="${ZPOOL}"
	zfsmnt "${_data}"
	_res=$?
	ZPOOL="${_OZPOOL}"

	if [ ${_res} -eq 1 ]; then
		${ZFS_CMD} unmount -f ${_data}
		${RMDIR_CMD} ${_data}
	fi
}

# Create filesystem directory for environment.
# Uses ZFS, HAMMER2, or plain mkdir depending on features.
create_fs()
{
	local _data="${1}"

	[ -z "${_data}" ] && return 1

	if [ "${zfsfeat}" = "1" ]; then
		create_zfs_fs -d "${_data}"
	elif [ "${hammerfeat}" = "1" ]; then
		create_hammer_fs "${jname}"
	else
		[ ! -d "${_data}" ] && ${MKDIR_CMD} -p "${_data}"
	fi

	return 0
}

# Create ZFS dataset or clone from snapshot.
# -d data path (mountpoint)
# -m mount_point (can be "none" to skip mountpoint setting)
# -n jail/dataset name (default: $jname)
# -p promote dataset (0 or 1)
# -z zfs snapshot source for clone
create_zfs_fs()
{
	local _data= _mount_point= _name= _promote= _encrypt_args=
	local _cmd= _zfs_snapsrc= _ret= ZPOOL= _res= _keyformat=

	while getopts "d:m:n:p:z:" opt; do
		case "${opt}" in
			d) _data="${OPTARG}" ;;
			m) _mount_point="${OPTARG}" ;;
			n) _name="${OPTARG}" ;;
			p) _promote="${OPTARG}" ;;
			z) _zfs_snapsrc="${OPTARG}" ;;
		esac
		shift $(( OPTIND - 1 ))
	done

	[ -z "${_data}" ] && return 0
	[ -z "${_name}" ] && _name="${jname}"
	[ -n "${zfs_snapsrc}" ] && _zfs_snapsrc="${zfs_snapsrc}"
	[ -z "${_promote}" ] && _promote=0

	capture ZPOOL ${ZFS_CMD} get -Ho value name ${jaildatadir}

	if zfsroot ${_name}; then
		log_err 1 "create_zfs_fs: ${ZPOOL}/${_name} already in use"
	fi

	if [ "${zfs_encryption}" = "1" ]; then
		# at the moment only keyphrase method supported
		_keyformat="passphrase"
	fi

	if [ "${_keyformat}" = "passphrase" ]; then
		if [ -n "${NOINTER}" ] || [ "${inter}" = "1" ]; then
			err 1 "${N1_COLOR}${CIX_APP} keyformat is passphrase, skip for non-interactive mode${N0_COLOR}"
		else
			_encrypt_args="-o encryption=on -o keyformat=passphrase"
		fi
	else
		_encrypt_args=
	fi

	if [ -z "${_zfs_snapsrc}" ]; then
		_cmd="${ZFS_CMD} create ${zfs_create_flags} -o mountpoint=${_data} ${_encrypt_args:+${_encrypt_args} }${ZPOOL}/${_name}"
		_res=$( ${_cmd} 2>&1 )
		_ret=$?
		cbsdlogger NOTICE ${CIX_APP}: create_zfs_fs errcode: ${_ret}: ${_cmd}
		[ ${_ret} -ne 0 ] && log_err 1 "${N1_COLOR}create_zfs_fs: zfs create failed: ${_res}. No ZFS and zfsfeat=1?${N0_COLOR}"
		cbsdlogger NOTICE ${CIX_APP}: create_zfs_fs: ZFS ${ZPOOL}/${_name} has been created with mountpoint: ${_data}, opt: ${zfs_create_flags}
	else
		_res=$( ${ZFS_CMD} clone -p ${_zfs_snapsrc} ${ZPOOL}/${_name} 2>&1 )
		_ret=$?
		[ ${_ret} -ne 0 ] && log_err 1 "${N1_COLOR}create_zfs_fs: zfs clone failed, code: ${_ret}: ${_res}${N0_COLOR}"
		cbsdlogger NOTICE ${CIX_APP}: ZFS cloned: ${_zfs_snapsrc} to ${ZPOOL}/${_name}

		if [ "${_mount_point}" != "none" ]; then
			if [ -n "${_mount_point}" ]; then
				${ZFS_CMD} set mountpoint=${_mount_point} ${ZPOOL}/${_name}
				_ret=$?
				cbsdlogger NOTICE ${CIX_APP}: create_zfs_fs errcode: ${_ret}: set mountpoint=${_mount_point}
			else
				${ZFS_CMD} set mountpoint=${_data} ${ZPOOL}/${_name}
				_ret=$?
				cbsdlogger NOTICE ${CIX_APP}: create_zfs_fs errcode: ${_ret}: set mountpoint=${_data}
			fi
		fi
	fi

	# Workaround: ZFS device node may not appear immediately after create+create sequence
	# under heavy load or XEN Dom0. Brief pause allows udev to settle.
	${SYNC_CMD} > /dev/null 2>&1 || true
	case "${emulator}" in
		xen)
			sleep 1
			;;
		bhyve)
			sleep 0.1
			;;
	esac

	if [ ${_promote} -eq 1 ]; then
		${ECHO} "${N1_COLOR}ZFS promoting for: ${N2_COLOR}${ZPOOL}/${_name}${N0_COLOR}"
		cbsdlogger NOTICE ${CIX_APP}: zfs promoting for: ${ZPOOL}/${_name}
		${ZFS_CMD} promote ${ZPOOL}/${_name}
	fi

	return 0
}


# Create HAMMER2 PFS for environment.
create_hammer_fs()
{
	[ -z "${1}" ] && return 1
	local _dname="${1}"

	${HAMMER2_CMD} -t MASTER pfs-create "${jaildatadir}/${_dname}-${jaildatapref}"
	[ ! -d "${jaildatadir}/${_dname}-${jaildatapref}" ] && ${MKDIR_CMD} -p "${jaildatadir}/${_dname}-${jaildatapref}"
	${MOUNT_HAMMER2_CMD} "@${jaildatadir}/${_dname}-${jaildatapref}" "${jaildatadir}/${_dname}-${jaildatapref}"
}

# Destroy HAMMER2 PFS for environment.
destroy_hammer_fs()
{
	[ -z "${1}" ] && return 1
	local _dname="${1}"

	${UMOUNT_CMD} "${jaildatadir}/${_dname}-${jaildatapref}"
	${HAMMER2_CMD} pfs-delete "${jaildatadir}/${_dname}-${jaildatapref}"
}

###
fi
