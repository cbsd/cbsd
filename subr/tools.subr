if [ ! "$_CBSD_TOOLS_SUBR" ]; then
_CBSD_TOOLS_SUBR=1
###

### Detect CARP/interface binding in IP addresses.
### Checks for '#' separator in comma-separated IP list (e.g. "em0#10.0.0.1" or "vhid_1#10.0.0.1/24").
### Prints: host-part after '#' when found, or full input when no '#' present.
### Returns: 0 when no '#' found; non-zero (position) when '#' found.
is_special_ip()
{
	local _pos= _p1= _p2= _ip= _i= _res=
	_ip="${1}"

	[ -z "${_ip}" ] && return 0

	OIFS="${IFS}"
	IFS=","		# multiple IP separator

	for _i in ${_ip}; do
		IFS="${OIFS}"
		strpos --str="${_i}" --search="#"
		_pos=$?
		if [ ${_pos} -ne 0 ]; then
			# vhid or with iface
			_p1=${_i%%#*}
			_p2=${_i##*#}
			if [ -z "${_res}" ]; then
				_res="${_p2}"
			else
				_res="${_res},${_p2}"
			fi
		fi
		IFS=","		# multiple IP separator
	done
	IFS="${OIFS}"

	[ -z "${_res}" ] && _res="${_ip}"

	printf "${_res}"
	return ${_pos}
}


### Identify IP address type.
### Returns: 0=undefined, 1=IPv4, 2=IPv6.
### Sets globals: IWM, VHID, IPWVHID, V_INTERFACE, V_IP for CARP/iface entries.
iptype()
{
	local prefix= p1= p2= ip= _special=0
	[ -z "${1}" ] && return 0
	ip="${1}"

	unset VHID IPWVHID V_INTERFACE V_IP

	is_special_ip "${ip}" > /dev/null 2>&1
	_special=$?

	# CARP or with IFACE
	if [ ${_special} -ne 0 ]; then
		capture prefix substr --pos=0 --len=4 --str="${ip}"
		if [ "${prefix}" = "vhid" ]; then
			p1=${ip%%#*}	# cut all after '#'
			IPWVHID=${ip##*#}	# cut all before '#' (ip with mask)
			ipwmask "${IPWVHID}"	# get IWM
			VHID=${p1##*_}		# get VHID
			! is_number "${VHID}" && err 1 "${N1_COLOR}Error in iptype: vhid should be number${N0_COLOR}"
		else
			# cut network prefix if exist
			V_INTERFACE=${ip%%#*}
			V_IP=${ip##*#}
			ipwmask "${V_IP}"
		fi
	else
		ipwmask "${1}"
	fi

	[ -z "${IWM}" ] && return 0

	capture prefix substr --pos=0 --len=4 --str="${IWM}"

	if [ "${prefix}" = "vhid" ]; then
		IPWVHID=
		p1=${IWM%%#*}
		IPWVHID=${IWM##*#}
		VHID=${p1##*_}
		! is_number "${VHID}" && err 1 "${N1_COLOR}Error in iptype: vhid should be number${N0_COLOR}"
	fi

	# Identify type {inet,inet6}.
	case "${IWM}" in
		*\.*\.*\.*)
			echo "${IWM}" | ${GREP_CMD} -E -q '^([[:digit:]]{1,3}\.){3}[[:digit:]]{1,3}$' && return 1
			# its not ip
			return 0
		;;
		*:*)
			return 2
		;;
		*)	return 0
		;;
	esac
}

### Resolve hostname to IP address using configured protocol (IPv4/IPv6).
### Prints resolved address on success.
resolvhost()
{
	local _host= proto=

	if [ "${node_ip6_active}" = "1" ]; then
		proto="6"
	else
		proto="4"
	fi

	capture _host ${miscdir}/resolv ${proto} ${1}

	[ $? -eq 0 ] && echo ${_host}
}

### Convert size string (e.g. "1g", "512m") to bytes.
### Numeric-only input is passed through as-is.
### Returns: 0 on success, 1 on error. Result stored in $convval.
conv2bytes()
{
	local _testsize= _value= _num= _postfix=

	[ -z "${1}" ] && return 1

	if is_number "${1}"; then
		convval="${1}"
		return 0
	fi

	capture convval ${miscdir}/conv2human ${1}
	[ -z "${convval}" ] && return 1
	[ ${convval} -gt 0 ] || return 1
}

### Convert bytes to human-readable form (e.g. "1g", "512k").
### Returns: 0 on success, 1 on empty input. Result stored in $convval (lowercase).
conv2human()
{
	[ -z "${1}" ] && return 1
	capture convval ${miscdir}/conv2human ${1} && capture convval ${TR_CMD} '[:upper:]' '[:lower:]' <<< "${convval}"
	return $?
}

### Calculate first usable IP in subnet: (IP AND mask) + 1 in last octet.
### Args: $1-$4 = IP octets, $5-$8 = mask octets. Pure shell arithmetic.
first_ips_w_mask()
{
	printf "%d.%d.%d.%d\n" "$(($1 & $5))" "$(($2 & $6))" "$(($3 & $7))" "$(( ($4 & $8) + 1 ))"
}

### Convert dotted subnet mask to CIDR prefix length.
### Example: mask2cdr 255.255.255.248 → 29. Pure shell arithmetic.
mask2cdr()
{
	# Assumes there's no "255." after a non-255 byte in the mask
	local x=${1##*255.}
	set -- 0^^^128^192^224^240^248^252^254^ $(( (${#1} - ${#x})*2 )) ${x%%.*}
	x=${1%%$3*}
	echo $(( $2 + (${#x}/4) ))
}

### Convert CIDR prefix length to dotted subnet mask.
### Example: cdr2mask 24 → 255.255.255.0. Pure shell arithmetic.
cdr2mask()
{
	# Number of args to shift, 255..255, first non-255 byte, zeroes
	set -- $(( 5 - ($1 / 8) )) 255 255 255 255 $(( (255 << (8 - ($1 % 8))) & 255 )) 0 0 0
	[ $1 -gt 1 ] && shift $1 || shift
	echo ${1-0}.${2-0}.${3-0}.${4-0}
}

### Validate MAC address format (xx:xx:xx:xx:xx:xx, hex case-insensitive).
### Returns: 0=valid, 1=invalid. Works with mac_gen output.
validate_hwaddr()
{
	[ -z "${1}" ] && return 1
	case "${1}" in
		[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]) return 0 ;;
	esac
	return 1
}

### Check if a remote node is online via lock file.
### Returns: 0=online (or skip check), 1=offline. Used by select_jail_by_list.
node_state()
{
	[ -z "${nodename}" ] && return 0 # nothing to test
	[ ${only_local} -eq 0 ] && return 0 # local only
	[ ${only_online_node} -eq 1 ] && return 0 # any nodes

	local ip=

	cbsdsqlro_vars nodes "SELECT ip FROM nodelist WHERE nodename='${nodename}'" ip
	[ -z "${ip}" ] && return 0 # nothing to test

	if ! check_locktime ${ftmpdir}/shmux_${ip}.lock >/dev/null 2>&1; then
		return 1	# Offline
	else
		return 0	# Online
	fi
}

### Convert seconds to human-readable time string.
### Prints: "N sec.", "N min.", "N hours.", "N days.", or "N month".
### Pure shell arithmetic. Returns 0 (always).
conv_time()
{
	local _i=0 in="${1}"

	[ -z "${in}" ] && return 0

	for _i in 1 2 3 4 5; do
		case "${_i}" in
			1)
				# seconds -> minutes
				if [ ${in} -lt 300 ]; then
					printf "${in} sec."
					return 0
				else
					in=$(( in / 60 ))
					continue
				fi
				;;
			2)
				# minutes -> hours
				if [ ${in} -lt 300 ]; then
					printf "${in} min."
					return 0
				else
					in=$(( in / 60 ))
					continue
				fi
				;;
			3)
				# hours -> days
				if [ ${in} -lt 73 ]; then
					printf "${in} hours."
					return 0
				else
					in=$(( in / 24 ))
					continue
				fi
				;;
			4)
				# days -> weeks
				if [ ${in} -lt 14 ]; then
					printf "${in} days."
					return 0
				else
					in=$(( in / 7 ))
					continue
				fi
				;;
			5)
				printf "${in} month"
				return 0
				;;
		esac
	done
}


### Interactive jail selection dialog from a list of jails.
### Options: -a (active filter), -e (emulator), -l (limit scope), -o (online-only),
###          -r (remote nodes), -s (subject text). Sets $jname on success.
select_jail_by_list()
{
	local _tmpdir= _tmpfile= _ret= _id= i=1 curr_time= rtime=
	local sqldelimer=" " emulator="jls" _bhyve_local_sqlite= _list_only=

	local only_local=0	# default - local node only
	local subject="List of online jails:"

	local searchstr= active="."
	local only_online_node=0	# only online node

	while getopts "a:e:l:o:r:s:" opt; do
		case "${opt}" in
			a) active="${OPTARG}" ;;
			e) emulator="${OPTARG}" ;;
			l) _list_only="${OPTARG}" ;;
			o) only_online_node="${OPTARG}" ;;
			r) only_local="${OPTARG}" ;;
			s) subject="${OPTARG}" ;;
		esac
		shift $(($OPTIND - 1))
	done

	. "${strings}"

	if [ ${only_local} -eq 0 ]; then
		searchstr="env NOCOLOR=1 ${emulator} alljails=0"
	else
		searchstr="env NOCOLOR=1 ${emulator} alljails=1"
		. "${nodes}"
	fi

	case "${emulator}" in
		j*)
			stuff="jails"
			;;
		b*)
			stuff="bhyve"
			;;
		x*)
			stuff="xen"
			;;
	esac

	${ECHO} "${N1_COLOR}${subject}${N0_COLOR}"

	capture _tmpdir ${MKTEMP_CMD} -d
	capture _tmpfile ${MKTEMP_CMD}

	local my_nodename="${nodename}"

	gettime curr_time

	${searchstr} display=nodename,jname,status header=0 order=asc jname="${_list_only}" | ${GREP_CMD} -E ${active}$ | while read nodename jname status; do
		# continue only when any node status or when node is online (when -r 1)
		node_state || continue
		[ -z "${nodename}" ] && continue
		[ "${nodename}" = "${my_nodename}" ] && nodename="local"
		[ -z "${jname}" ] && continue

		case "${status}" in
			On)
				active=1
				;;
			*)
				active=0
				;;
		esac

		echo "${active}:${jname}:${nodename}" >> ${_tmpdir}/${jname}.img

		case "${emulator}" in
			jls)
				cbsdsqlro_vars local "SELECT ip4_addr,ver,host_hostname,state_time FROM jails WHERE jname='${jname}'"
				diff_time=$(( curr_time - state_time ))
				capture rtime conv_time ${diff_time}
				if [ ${active} -eq 1 ]; then
					${ECHO} "${H5_COLOR}ip_addr: ${H3_COLOR}${ip4_addr}${H5_COLOR}; hostname: ${H3_COLOR}${host_hostname}${H5_COLOR}; ver: ${H3_COLOR}${ver}${H5_COLOR}; uptime: ${H3_COLOR}${rtime}" > ${_tmpdir}/${jname}.descr
				else
					${ECHO} "${H5_COLOR}ip_addr: ${H3_COLOR}${ip4_addr}${H5_COLOR}; hostname: ${H3_COLOR}${host_hostname}${H5_COLOR}; ver: ${H3_COLOR}${ver}${H5_COLOR}; downtime: ${H3_COLOR}${rtime}" > ${_tmpdir}/${jname}.descr
				fi
				;;
			bls)
				if [ "${nodename}" = "local" ]; then
					_bhyve_local_sqlite="${jailsysdir}/${jname}/local.sqlite"
				else
					_bhyve_local_sqlite="${tmpdir}/${nodename}/${jname}/local.sqlite"
				fi
				if [ -r ${_bhyve_local_sqlite} ]; then
					cbsdsqlro_vars ${_bhyve_local_sqlite} "SELECT ip4_addr,vm_cpus,vm_os_type,state_time FROM settings"
					cbsdsqlro_vars local "SELECT host_hostname FROM jails WHERE jname='${jname}'"
					diff_time=$(( curr_time - state_time ))
					if ! is_number "${diff_time}"; then
						diff_time=0
					else
						[ ${diff_time} -lt 0 ] && diff_time=0	# protection from wrong time
					fi
					capture rtime conv_time ${diff_time}
					if [ ${active} -eq 1 ]; then
						${ECHO} "${H5_COLOR}ip_addr: ${H3_COLOR}${ip4_addr}${H5_COLOR}; hostname: ${H3_COLOR}${host_hostname}${H5_COLOR}; os: ${H3_COLOR}${vm_os_type}${H5_COLOR}; core's: ${H3_COLOR}${vm_cpus}${H5_COLOR}; uptime: ${H3_COLOR}${rtime}" > ${_tmpdir}/${jname}.descr
					else
						${ECHO} "${H5_COLOR}ip_addr: ${H3_COLOR}${ip4_addr}${H5_COLOR}; hostname: ${H3_COLOR}${host_hostname}${H5_COLOR}; os: ${H3_COLOR}${vm_os_type}${H5_COLOR}; core's: ${H3_COLOR}${vm_cpus}${H5_COLOR}; ${H5_COLOR}downtime: ${H3_COLOR}${rtime}" > ${_tmpdir}/${jname}.descr
					fi
				fi
				;;
			xls)
				if [ "${nodename}" = "local" ]; then
					_xen_local_sqlite="${jailsysdir}/${jname}/local.sqlite"
				else
					_xen_local_sqlite="${tmpdir}/${nodename}/${jname}/local.sqlite"
				fi
				if [ -r ${_xen_local_sqlite} ]; then
					cbsdsqlro_vars ${_xen_local_sqlite} "SELECT ip4_addr,vm_cpus,vm_os_type,state_time FROM settings"
					cbsdsqlro_vars local "SELECT host_hostname FROM jails WHERE jname='${jname}'"
					diff_time=$(( curr_time - state_time ))
					if ! is_number "${diff_time}"; then
						diff_time=0
					else
						[ ${diff_time} -lt 0 ] && diff_time=0	# protection from wrong time
					fi
					capture rtime conv_time ${diff_time}
					if [ ${active} -eq 1 ]; then
						${ECHO} "${H5_COLOR}ip_addr: ${H3_COLOR}${ip4_addr}${H5_COLOR}; hostname: ${H3_COLOR}${host_hostname}${H5_COLOR}; os: ${H3_COLOR}${vm_os_type}${H5_COLOR}; core's: ${H3_COLOR}${vm_cpus}${H5_COLOR}; uptime: ${H3_COLOR}${rtime}" > ${_tmpdir}/${jname}.descr
					else
						${ECHO} "${H5_COLOR}ip_addr: ${H3_COLOR}${ip4_addr}${H5_COLOR}; hostname: ${H3_COLOR}${host_hostname}${H5_COLOR}; os: ${H3_COLOR}${vm_os_type}${H5_COLOR}; core's: ${H3_COLOR}${vm_cpus}${H5_COLOR}; ${H5_COLOR}downtime: ${H3_COLOR}${rtime}" > ${_tmpdir}/${jname}.descr
					fi
				fi
				;;
		esac
	done

	select_jail ${_tmpdir} ${_tmpfile} img CANCEL 2>/dev/null
	_ret=$?
	${RM_CMD} -rf ${_tmpdir}

	case "${_ret}" in
		0)
			read -r jname < ${_tmpfile}
			${RM_CMD} -f ${_tmpfile}
			;;
		1)
			${RM_CMD} -f ${_tmpfile}
			err 0 "${N1_COLOR}Cancel pressed${N0_COLOR}"
			;;
		2)
			${RM_CMD} -f ${_tmpfile}
			err 1 "${N1_COLOR}select_jail error${N0_COLOR}"
			;;
	esac

	remote=2 # for autoremote

}

### Prepare jail filesystem hierarchy for offline command execution.
### Mounts devfs and fstab. Requires $jname and $path to be set.
prepare_offline_jail()
{
	mountbase -o "" -p "" -d "" -c "" -s ""
	[ -r "${mount_fstab}" ] && mountfstab jname="${jname}"
	if [ ! -d ${path}/dev ]; then
		${MKDIR_CMD} ${path}/dev
		${MOUNT_CMD} -t devfs devfs ${path}/dev
	else
		${miscdir}/mountpoint ${path}/dev || ${MOUNT_CMD} -t devfs devfs ${path}/dev
	fi
	makeresolv jname=${jname}
}

### Generate random MAC address with given OUI prefix.
### Args: $1 = OUI (e.g. "02:ff:f0"), $2 = count (default 1).
### Prints MAC(s) in xx:xx:xx:xx:xx:xx format. Returns 1 if OUI empty.
mac_gen()
{
	local OUI="${1}"
	local num="${2:-1}" _i=

	[ -z "${OUI}" ] && return 1

	for ((_i=1; _i<=${num}; _i++)); do
		echo -n "${OUI}"; ${DD_CMD} bs=1 count=3 if=/dev/random 2>/dev/null | ${HEXDUMP_CMD} -v -e '/1 ":%02x"'
		echo
	done
}

### Internal pipeline for random password generation.
### Args: $1 = byte length to read from /dev/random.
### Runs: head → uuencode → grep → tr chain. Must be called from a function wrapper.
_randompw_pipeline()
{
	${HEAD_CMD} -c ${1} /dev/random | ${UUENCODE_CMD} -m - | ${GREP_CMD} -E -v '(^begin-base)|^====$' | ${TR_CMD} -d '\r\n=' | ${TR_CMD} "/" "x"
}

### Generate random password of specified length.
### Options: -l LENGTH (default 30). Uses _randompw_pipeline internally.
### Prints password to stdout.
random_password_gen()
{
	local _length= _extra_len= _pw=

	while getopts "l:" opt; do
		case "${opt}" in
			l) _length="${OPTARG}" ;;
		esac
		shift $(($OPTIND - 1))
	done

	[ -z "${_length}" ] && _length="30"
	_extra_len=$(( _length + 8 ))

	capture _pw _randompw_pipeline ${_extra_len}
	capture _pw substr --pos=0 --len=${_length} --str="${_pw}"
	printf "${_pw}"
}

### Check if $jname is a wildcard mask (contains '*').
### If so, queries DB for matching jail names into $jail_list.
### Requires $jname and $emulator globals to be set.
jname_is_multiple()
{
	jail_list=

	# We accept jname with wildcard '*' e.g.: jail*, *vnet*
	# jail as mask?
	local _is_mask=0
	local _jail_mask=
	local _jail_pref=

	capture _jail_pref substr --pos=0 --len=1 --str="${jname}"

	if [ "${_jail_pref}" = "*" ]; then
		_is_mask=1
	else
		strpos --str="${jname}" --search="*" || _is_mask=1
	fi

	if [ ${_is_mask} -ne 0 ]; then
		capture _jail_mask ${TR_CMD} "*" "%" <<< "${jname}"
		cbsdsqlro_vars local "SELECT jname FROM jails WHERE emulator = '${emulator}' AND jname LIKE '${_jail_mask}'" jail_list
	fi
}

### Print byte value for $1. Numeric passthrough, or convert via conv2human (e.g. "1g" → 1073741824).
### Returns: 0 on success, 1 on empty/invalid input.
get_bytes()
{
	local _val="0"

	[ -z "${1}" ] && return 1

	if is_number "${1}"; then
		_val=${1}
	else
		capture _val ${miscdir}/conv2human "${1}"
	fi
	[ -z "${_val}" ] && return 1
	printf "${_val}"
	return 0
}

### Rotate file-based lease records (<item>:<expiretime>).
### Removes expired entries, prints surviving keys as space-separated list.
### Options: -l LEASE_FILE. Must run under lock.
rotate_lease_file()
{
	local _lease_file= _leasefile_skiplist=

	while getopts "l:" opt; do
		case "${opt}" in
			l) _lease_file="${OPTARG}" ;;
		esac
		shift $(($OPTIND - 1))
	done

	# prune/purge old records
	if [ -r ${_lease_file} ]; then
		${TRUNCATE_CMD} -s0 ${_lease_file}.swap
		gettime cur_time
		while read items; do
			p1=${items%%:*}
			p2=${items##*:}
			[ -z "${p1}" ] || [ -z "${p2}" ] && continue
			if [ ${p2} -gt ${cur_time} ]; then
				echo "${items}" >> ${_lease_file}.swap
				if [ -z "${_leasefile_skiplist}" ]; then
					_leasefile_skiplist="${p1}"
				else
					_leasefile_skiplist="${_leasefile_skiplist} ${p1}"
				fi
			fi
		done < ${_lease_file}
		${MV_CMD} ${_lease_file}.swap ${_lease_file}
		sync
		[ -n "${_leasefile_skiplist}" ] && printf "${_leasefile_skiplist}"
	fi
	return 0
}

### Check if a shell function with the given name is defined.
### Returns: 0 if exists, 1 if not.
fn_exists()
{
	LC_ALL=C type ${1} | ${GREP_CMD} -q 'shell function'
}

### Execute a command under a file lock with timeout.
### Args: $1=timeout(s), $2=lockfile, $*=command. Uses flock(1) on Linux/NetBSD, lockf(1) on others.
### WARNING: uses 'exec' — replaces current process.
cbsd_lock()
{
	local _timeout="${1}"
	local _lockfile="${2}"
	shift; shift;

	case "${platform}" in
		Linux|NetBSD)
			exec ${FLOCK_CMD} -w${_timeout} -x ${_lockfile} ${*}
			;;
		*)
			exec ${LOCKF_CMD} -s -t${_timeout} ${_lockfile} ${*}
			;;
	esac

}

### Return file size in bytes using stat(1). Prints "0" and returns 1 for unreadable files.
### Auto-detects platform (Linux vs BSD) via uname -s independent of $platform variable.
get_file_bytes()
{
	local _file="${1}"
	local _val=0
	local _platform=

	if [ ! -r "${_file}" ]; then
		echo -n "0"
		return 1
	fi

	# don't look at $platform, get original
	capture _platform ${UNAME_CMD} -s

	case "${_platform}" in
		Linux)
			capture _val ${STAT_CMD} --printf="%s" "${_file}"
			;;
		*)
			capture _val ${STAT_CMD} -f "%z" "${_file}"
			;;
	esac

	if [ -n "${_val}" ]; then
		# is_number?
		echo -n "${_val}"
	else
		echo -n "0"
		return 1
	fi

	return 0
}

### Return allocated blocks for file using stat(1). Prints "0" and returns 1 for unreadable files.
### Auto-detects platform (Linux vs BSD) via uname -s independent of $platform variable.
get_file_blocks()
{
	local _file="${1}"
	local _val=0
	local _platform=

	if [ ! -r "${_file}" ]; then
		echo -n "0"
		return 1
	fi

	# don't look at $platform, get original
	capture _platform ${UNAME_CMD} -s

	case "${_platform}" in
		Linux)
			capture _val ${STAT_CMD} --printf="%b" "${_file}"
			;;
		*)
			capture _val ${STAT_CMD} -f "%b" "${_file}"
			;;
	esac

	if [ -n "${_val}" ]; then
		# is_number?
		echo -n "${_val}"
	else
		echo -n "0"
		return 1
	fi

	return 0
}

# Platform-neutral kernel module check/load.
#   -l  — load the module if not already loaded
#   -q  — quiet mode (no diagnostic output to stderr)
# Returns:
#   0 — module is loaded (or was loaded successfully with -l)
#   1 — module is not loaded (or failed to load, or no platform equivalent)
# Module aliases (FreeBSD name → Linux name):
#   if_bridge  → bridge
#   if_tuntap  → tun
#   if_tap     → tap
#   fusefs     → fuse
#   zfs        → zfs
#   (modules without Linux equivalent return 1 on Linux)
# Examples:
#   kernel_mod zfs                  # check only
#   kernel_mod -l if_bridge         # load if not present
#   kernel_mod -lq carp             # load quietly
#   kernel_mod -q fusefs            # check quietly
kernel_mod()
{
	local _load=0 _quiet=0 _mod=

	while [ $# -gt 0 ]; do
		case "$1" in
			-l) _load=1 ;;
			-q) _quiet=1 ;;
			-*) ;; # unknown flag, skip
			*)  _mod="${1}" ;;
		esac
		shift
	done

	[ -z "${_mod}" ] && return 1

	# Resolve platform-specific module name
	case "${platform}" in
		Linux)
			case "${_mod}" in
				if_bridge)	_mod="bridge" ;;
				if_tuntap)	_mod="tun" ;;
				if_tap)		_mod="tap" ;;
				fusefs)		_mod="fuse" ;;
				alias|libalias)	return 1 ;;
				ipfw_nat)	return 1 ;;
				ipfilter)	return 1 ;;
				nmdm)		return 1 ;;
				carp)		return 1 ;;
				vmm)		_mod="kvm_intel" ;;
				nvmm)		return 1 ;;
				linux_common)	return 1 ;;
				linux64elf|linux64) return 1 ;;
			esac
			;;
		*)
			case "${_mod}" in
				alias)	_mod="libalias" ;;
			esac
			;;
	esac

	# Check if module is loaded
	case "${platform}" in
		Linux)
			if [ -r /proc/modules ]; then
				${GREP_CMD} -q "^${_mod} " /proc/modules 2>/dev/null
			else
				return 1
			fi
			;;
		*)
			${KLDSTAT_CMD} -qm ${_mod} >/dev/null 2>&1
			;;
	esac

	if [ $? -eq 0 ]; then
		return 0
	fi

	# Not loaded — load if requested
	if [ ${_load} -eq 1 ]; then
		case "${platform}" in
			Linux)
				${MODPROBE_CMD} ${_mod} >/dev/null 2>&1
				;;
			*)
				${KLDLOAD_CMD} ${_mod} >/dev/null 2>&1
				;;
		esac
		return $?
	fi

	return 1
}

###
fi
