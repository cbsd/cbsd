# syslog=1: host-side jail log. See LOGGER.md.
if [ ! "$_CBSD_CBSDLOG_SUBR" ]; then
_CBSD_CBSDLOG_SUBR=1

cbsdlog_active()
{
	[ "${syslog}" = "1" ]
}

# Fail the caller. Used when the jail is not up yet.
cbsdlog_run()
{
	cbsdlog_active || return 0
	if [ ! -x "${miscdir}/cbsdlogctl" ]; then
		err 1 "${N1_COLOR}cbsdlogctl is not installed: ${N2_COLOR}${miscdir}/cbsdlogctl${N0_COLOR}"
	fi
	${miscdir}/cbsdlogctl "$@" || \
		err 1 "${N1_COLOR}cbsdlogctl ${*} failed for ${N2_COLOR}${jname}${N0_COLOR}"
}

# Warn and continue. Used after the jail is already stopped or being removed.
cbsdlog_run_soft()
{
	cbsdlog_active || return 0
	if [ ! -x "${miscdir}/cbsdlogctl" ]; then
		${ECHO} "${N1_COLOR}cbsdlogctl is not installed: ${N2_COLOR}${miscdir}/cbsdlogctl${N0_COLOR}" 1>&2
		return 0
	fi
	${miscdir}/cbsdlogctl "$@" || \
		${ECHO} "${N1_COLOR}cbsdlogctl ${*} failed for ${N2_COLOR}${jname}${N0_COLOR}" 1>&2
}

cbsdlog_create()
{
	cbsdlog_run create "${jname}"
}

cbsdlog_enable()
{
	# ${data}/var is the jail's /var (nullfs when baserw=0, the root itself when baserw=1).
	local _sockdir="${data}/var/run"

	cbsdlog_active || return 0
	[ -n "${data}" ] || \
		err 1 "${N1_COLOR}cbsdlog: empty data for ${N2_COLOR}${jname}${N0_COLOR}"
	${MKDIR_CMD} -p "${_sockdir}" || \
		err 1 "${N1_COLOR}mkdir ${N2_COLOR}${_sockdir}${N0_COLOR}"
	cbsdlog_run enable "${jname}" "${_sockdir}"
}

cbsdlog_disable()
{
	cbsdlog_run_soft disable "${jname}"
}

cbsdlog_destroy()
{
	cbsdlog_run_soft destroy "${jname}"
}

# Sets $LOGSET. Empty when syslog is off. Insert it in front of the
# jail command so cbsdlogctl can take that command's stdout and stderr.
cbsdlog_logset()
{
	LOGSET=
	cbsdlog_active || return 0
	LOGSET="${miscdir}/cbsdlogctl exec ${jname} --"
}

fi
