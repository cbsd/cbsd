if [ ! "$_CBSD_SUDOEXEC_SUBR" ]; then
_CBSD_SUDOEXEC_SUBR=1
###
# wrapper for sudoexec scripts
pgm="${0##*/}"
CBSD_SUDO=1

if [ -z "${CIX_BIN}" ]; then
	capture CIX_BIN command -v cbsd 2>/dev/null
	[ -z "${CIX_BIN}" ] && CIX_BIN="/usr/local/bin/cbsd"
fi

capture _uid id -u
if [ "${_uid}" != "0" ]; then
	capture SUDO_CMD command -v sudo 2>/dev/null
	[ -z "${SUDO_CMD}" ] && SUDO_CMD="/usr/local/bin/sudo"
	SUDO_CMD="${SUDO_CMD} -E"
else
	SUDO_CMD=
fi

exec ${SUDO_CMD} "${CIX_BIN}" "${CIX_DISTDIR}/sudoexec/${pgm}" "$@"

###
fi
