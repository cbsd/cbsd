if [ ! "$_CBSD_SUDOEXEC_SUBR" ]; then
_CBSD_SUDOEXEC_SUBR=1
###
# wrapper for sudoexec scripts
pgm="${0##*/}"
CBSD_SUDO=1
if [ "$( id -u )" != "0" ]; then
	SUDO_CMD="/usr/local/bin/sudo -E"
	exec ${SUDO_CMD} ${CIX_DISTDIR}/sudoexec/${pgm} "$@"
else
	exec ${CIX_DISTDIR}/sudoexec/${pgm} "$@"
fi

###
fi
