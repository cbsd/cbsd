#!/usr/bin/env cbsd
CIXARG=""
CIXOPTARG="jname remote inter out"
CIXDESC="Dialog interface for xen disk management"
ADDHELP="out - generate config only (e.g. for non-existance new jail)"
CBSDMODULE="xen"

out=

. ${subrdir}/nc.subr
. ${dialog}
. ${strings}
. ${tools}
. ${subrdir}/vnet.subr
cixinit

[ -z "${CIX_BIN}" ] && CIX_BIN="/usr/local/bin/cbsd"
BSDCFG_LIBE="${CIX_DISTDIR}/share/bsdconfig/cbsd"
export NOCOLOR=1

if [ -z "${out}" ]; then
	[ -z "${jname}" ] && jname="${1}"
	[ -z "${jname}" ] && select_jail_by_list -s "List of local jails:" -r 0 -e xls
	[ -z "${jname}" ] && err 1 "please specify jname"
	. ${subrdir}/rcconf.subr
	[ $? -eq 1 ] && err 1 "${N1_COLOR}no such env: ${N2_COLOR}${jname}${N0_COLOR}"
	[ "${emulator}" != "xen" ] && err 1 "${N1_COLOR}not in jail mode${N0_COLOR}"
	mysqlite="${jailsysdir}/${jname}/local.sqlite"
else
	[ -z "${jname}" ] && err 1 "please specify jname"
	mysqlite="${out}"
echo "UNSUPPORTED"
exit 1
	if [ ! -r ${mysqlite} ]; then
		${CIX_BIN} ${miscdir}/updatesql ${mysqlite} ${CIX_DISTDIR}/share/local-jailnic.schema jailnic
		cbsdsqlrw ${mysqlite} "INSERT INTO jailnic ( name,nic_order,nic_slot,nic_parent,nic_hwaddr,nic_address,nic_mtu,nic_flags,nic_vlan_untagged,nic_vlan_tagged ) VALUES ( 'eth0','0','0','auto','${nic_hwaddr}','${nic_address}','0','0','0','0' )"
	fi
fi

dialog_menu_main()
{
	local _n _dsk_controller _dsk_path _dsk_slot _dsk_type _controller_id
	local _dsk_fullpath _dsk_realsize _dsk_size _dsk _du_out

	title="$DIALOG_TITLE"
	btitle="$DIALOG_BACKTITLE"
	prompt=" Virtual Machine: ${jname} "
	menu_list="
		'A $msg_add_new_img'	'${msg_add_new_img_desc}'	'Add and configure new virtual image'
		'-'	'-'	''
	"
	defaultitem=
	hline="$hline_arrows_tab_enter"

	for ((_n=1; _n<=16; _n++)); do
		unset _dsk_controller
		eval _dsk_controller="\$dsk_controller${_n}"
		[ -z "${_dsk_controller}" ] && break
		eval _dsk_path="\$dsk_path${_n}"
		eval _dsk_slot="\$dsk_slot${_n}"
		eval _dsk_type="\$dsk_type${_n}"
		eval _controller_id="\$controller_id${_n}"
		_dsk_fullpath="${data}/${_dsk_path}"

		capture _du_out /usr/bin/du -sh ${_dsk_fullpath}
		_dsk_realsize="${_du_out%%[[:space:]]*}"
		capture _dsk_size get_file_bytes ${_dsk_fullpath}

		if conv2human "${_dsk_size}"; then
			_dsk_size=${convval}
		fi
		[ -z "${_dsk_size}" ] && _dsk_size="?"
		[ -z "${_dsk_realsize}" ] && _dsk_realsize="?"

		_dsk="${_dsk_path%%.*}"
		menu_list="${menu_list} '${_n} ${_dsk}'	'${_dsk_controller}'	'pci=${_dsk_slot},type=${_dsk_type},size=${_dsk_realsize}/${_dsk_size},ctr_id=${_controller_id}'"
	done

	f_dialog_default_fetch defaultitem

	cbsd_menubox_with_help
	local retval=$?

	f_dialog_data_sanitize menu_choice
	f_dialog_menutag_store "$menu_choice"
	f_dialog_default_store "$menu_choice"

	return $retval
}

find_first_free_dsk_id()
{
	local _last_disk _res

	for ((_last_disk=1; _last_disk<=16; _last_disk++)); do
		unset _res
		capture _res cbsdsqlro ${jailsysdir}/${jname}/local.sqlite "SELECT dsk_path FROM xendsk WHERE jname='${jname}' AND dsk_path='dsk${_last_disk}.vhd'"
		if [ -z "${_res}" ]; then
			echo "${_last_disk}"
			return
		fi
	done

	echo "${_last_disk}"
}


. ${BSDCFG_LIBE}/include/messages-xendsk.subr
. ${subrdir}/rcconf.subr
[ $? -eq 1 ] && err 1 "${N1_COLOR}No such VM: ${N2_COLOR}${jname}${N0_COLOR}"
[ "${emulator}" != "xen" ] && err 1 "${N1_COLOR}Not in xen mode${N0_COLOR}"

. ${CIX_DISTDIR}/share/xen/xen-dsk.subr

while :; do
	load_dsk_info
	dialog_menu_main || break

	[ -z "${mtag}" ] && exit $SUCCESS

	_command=

	case "${mtag}" in
		?" $msg_exit") break ;;
		?" $msg_add_new_img")
			capture _last_disk find_first_free_dsk_id
			dsk="dsk${_last_disk}"
			_command="xendsk-newdsk jname=${jname} dsk=${dsk}"
			;;
		*)
			[ "${mtag}" = "-" ] && continue
			dsk=${mtag##* }
			_command="xendsk-cfgdsk jname=${jname} dsk=${dsk}"
			;;
	esac

	if [ "${_command}" ]; then
		${_command}
	fi

done

exit 0
