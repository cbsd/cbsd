# don't remove this line:
vm_profile="cloud-windows-ru-10_x86_64"
vm_os_type="windows"
# this is one-string additional info strings in dialogue menu
long_description="Windows: Microsoft Windows 10 (russian) (cloud)"

# custom settings:
fetch=1
fetch_ui_file="${vm_profile}.txt"

# Official resources to fetch ISO's
iso_site="https://mirror.convectix.com/cloud-extra/"
cbsd_iso_mirrors="https://mirror2.convectix.com/cloud-extra/"

iso_img="windows10ru-cloud.raw"
iso_img_dist="windows10ru-cloud.raw.xz"
iso_img_type="cloud"

iso_extract="nice -n 19 ${IDLE_IONICE} ${XZ_CMD} -d ${iso_img_dist}"

# register_iso as:
register_iso_name="cbsd-cloud-${iso_img}"
register_iso_as="raw-windows-2022-ru_x86_64"

default_jailname="windows"
vm_package="small1"
vm_ram="4g"
imgsize="11g"

imgsize_min="11811160064"		# 11g min

virtio_type="virtio-blk"
#virtio_type="ahci-hd"

# disable profile?
bhyve_active=1
qemu_active=1
xen_active=1

sectorsize="512/512"

# Available in ClonOS?
clonos_active=1

# Available for MyB? image name
myb_image="windows10_ru"

vm_vnc_port="0"
vm_efi="uefi"

#nic_driver="e1000"

bhyve_ignore_msr_acc="1"

# is template for vm_obtain
is_template=1
is_cloud=1

# VirtualBox Area
virtualbox_ostype="Windows8_64"
virtualbox_nictype="82540EM"

# enable birtio RNG interface?
virtio_rnd="0"

ci_template="windows"

sha256sum="9d51fd6c899d8e0de616b3647a60168003586bb9b3174d583ebae9b429591366"
iso_img_dist_size="2630299048"
