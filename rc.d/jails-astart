#!/bin/sh
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ -z "${CIX_BIN}" ] && CIX_BIN="/usr/local/bin/cbsd"

if [ ! -d "${CIX_DISTDIR}" ]; then
	echo "no such dist dir: ${CIX_DISTDIR}"
	exit 1
fi
if [ ! -x "${CIX_BIN}" ]; then
	echo "no such bin: ${CIX_BIN}"
	exit 1
fi

jails_stop()
{
	local localjails=
	local localbhyves=
	local localxens=
	local localqemus=

	localjails="$( ${CIX_BIN} jorder order=DESC )"
	localbhyves="$( ${CIX_BIN} border order=DESC )"
	localxens="$( ${CIX_BIN} xorder order=DESC )"
	localqemus="$( ${CIX_BIN} qorder order=DESC )"

	[ -n "${localjails}" ] && cbsdlogger NOTICE ${CIX_APP}: jail stop order: ${localjails}
	[ -n "${localbhyves}" ] && cbsdlogger NOTICE ${CIX_APP}: bhyve vm stop order: ${localbhyves}
	[ -n "${localxens}" ] && cbsdlogger NOTICE ${CIX_APP}: XEN vm stop order: ${localxens}
	[ -n "${localqemus}" ] && cbsdlogger NOTICE ${CIX_APP}: QEMU vm stop order: ${localqemus}

	for jname in ${localjails} ${localbhyves} ${localxens} ${localqemus}; do
		. ${subrdir}/rcconf.subr
		[ ${jid} -eq 0 ] && continue
		stoppid="${ftmpdir}/stop.${jname}.$$"
		${ECHO} "${N1_COLOR}${CIX_APP}: auto-stop ${emulator}: ${N2_COLOR}${jname}${N0_COLOR}"
		cbsdlogger NOTICE ${CIX_APP}: auto-stop ${emulator}: ${jname}
		case ${emulator} in
			bhyve)
				env TERM=xterm ${miscdir}/daemonize -E TERM=xterm -p ${stoppid} ${CIX_DISTDIR}/bhyvectl/bstop jname=${jname}
				;;
			jail)
				env TERM=xterm ${miscdir}/daemonize -E TERM=xterm -p ${stoppid} ${CIX_DISTDIR}/jailctl/jstop jname=${jname}
				;;
			xen)
				env TERM=xterm ${miscdir}/daemonize -E TERM=xterm -p ${stoppid} ${CIX_DISTDIR}/xenctl/xstop jname=${jname}
				;;
			qemu)
				env TERM=xterm ${miscdir}/daemonize -E TERM=xterm -p ${stoppid} ${CIX_DISTDIR}/qemuctl/qstop jname=${jname}
				;;
		esac
		# lets save .pid file
		sleep 1
		if [ -f "${stoppid}" ]; then
			PID=$( ${CAT_CMD} ${stoppid} 2>/dev/null )
			[ -n "${PID}" ] && cbsd_pwait --pid=$( ${CAT_CMD} ${stoppid} ) --timeout=${parallel}
		fi
	done
	wait_for_fpid stop
	return 0
}

jails_start()
{
	local jlist=
	local blist=
	local qlist=
	local xlist=
	local localjails= localbhyves= localxens= localqemus=

	localjails="$( jorder order=ASC )"
	localbhyves="$( border order=ASC )"
	localxens="$( xorder order=ASC )"
	localqemus="$( qorder order=ASC )"

	[ -n "${localjails}" ] && cbsdlogger NOTICE ${CIX_APP}: jail start order: ${localjails}
	[ -n "${localbhyves}" ] && cbsdlogger NOTICE ${CIX_APP}: bhyve vm start order: ${localbhyves}
	[ -n "${localqemus}" ] && cbsdlogger NOTICE ${CIX_APP}: QEMU vm start order: ${localqemus}
	[ -n "${localxens}" ] && cbsdlogger NOTICE ${CIX_APP}: XEN vm start order: ${localxens}

	for jname in ${localjails} ${localbhyves} ${localxens} ${localqemus}; do
		${toolsdir}/save-jail-info jname=${jname}
		. ${subrdir}/rcconf.subr
		if [ ${astart} -ne 1 ]; then
			cbsdlogger NOTICE ${CIX_APP}: astart=0, skip: ${jname}
			continue
		else
			cbsdlogger NOTICE ${CIX_APP}: astart=1, start scheduled: ${jname}
		fi
		case "${emulator}" in
			bhyve)
				blist="${blist} ${jname}"
				;;
			jail)
				jlist="${jlist} ${jname}"
				;;
			qemu)
				qlist="${qlist} ${jname}"
				;;
			xen)
				xlist="${xlist} ${jname}"
				;;
		esac
	done

	[ -n "${jlist}" ] && task mode=new autoflush=0 notify=0 owner=syscbsd ${CIX_BIN} jstart inter=0 ${jlist}
	[ -n "${blist}" ] && task mode=new autoflush=0 notify=0 owner=syscbsd ${CIX_BIN} bstart inter=0 ${blist}
	[ -n "${qlist}" ] && task mode=new autoflush=0 notify=0 owner=syscbsd ${CIX_BIN} qstart inter=0 ${qlist}
	[ -n "${xlist}" ] && task mode=new autoflush=0 notify=0 owner=syscbsd ${CIX_BIN} xstart inter=0 ${xlist}

	return 0
}

#### MAIN ####
case ${1} in
	start)
		jails_start
		;;
	stop)
		jails_stop
	;;
esac

exit 0
