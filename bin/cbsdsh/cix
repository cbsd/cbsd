#!/bin/sh
make distclean
gmake distclean
export CPPFLAGS="-I/usr/include -I/usr/local/include"
export LDFLAGS="-L/usr/lib -L/usr/local/lib"

export LD_LIBRARY_PATH="/usr/lib /usr/local/lib"
export C_INCLUDE_PATH="/usr/include /usr/local/include"

autoreconf -i
make clean
gmake clean
./configure --with-libsqlite3 --with-libjail

cd src
./run.sh
ret=$?

if [ ${ret} -ne 0 ]; then
	echo "ERROR"
	exit 1
fi

cd ../
make clean
gmake clean
make distclean
gmake distclean
