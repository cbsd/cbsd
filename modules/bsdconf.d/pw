#!/usr/bin/env cbsd
#v11.0.0
CBSDMODULE="bsdconf"
CIXARG=""
CIXOPTARG="jname fromfile"
MYDESC="cbsd pw wrapper"
ADDHELP="
${H3_COLOR}Description${N0_COLOR}:

 Wrapper for the pw(8) utility to manage users and groups,
 optionally inside a jail/chroot environment.

${H3_COLOR}Options${N0_COLOR}:

 ${N2_COLOR}jname=${N0_COLOR}    - target jail.
 ${N2_COLOR}fromfile=${N0_COLOR} - load params from file.

${H3_COLOR}Examples${N0_COLOR}:

 # cbsd pw jname=jail1 useradd testuser -m
 # cbsd pw jname=jail1 userdel testuser

${H3_COLOR}See also${N0_COLOR}:

 cbsd adduser --help
 cbsd passwd --help

"

. ${subrdir}/nc.subr
cixinit
cixinit

. ${system}

_MYDIR="${CIX_DISTDIR}/modules/bsdconf.d"

[ -n "${jname}" ] && shift

if [ -n "${fromfile}" ]; then
	shift
	[ -r "${fromfile}" ] && . ${fromfile}
fi

cmd=
maxarg=$#

while [ $maxarg -ne 0 ]; do
	part="$1"
	shift

	p1=${part%% *}
	p2=${part##* }

	if [ "${p1}" = "${p2}" ]; then
		cmd="${cmd} ${part}"
	else
		cmd="${cmd} \"${part}\""
	fi
	maxarg=$(( maxarg - 1 ))
done

[ -z "${cmd}" -a -z "${fromfile}" ] && err 1 "${N1_COLOR}Empty command${N0_COLOR}"

## MAIN ##
if [ -n "${jname}" ]; then
	. ${subrdir}/rcconf.subr
	[ $? -eq 1 ] && err 1 "${N1_COLOR}No such jail: ${N2_COLOR}${jname}${N0_COLOR}"

	[ $baserw -eq 1 ] && path=$data

	if [ ${jid} -eq 0 ]; then
		set -e
			. ${_MYDIR}/bsdconf.subr
		set +e
		. ${subrdir}/universe.subr
		readconf buildworld.conf
		init_target_arch
		init_srcdir
		init_basedir
		init_kerneldir
		prepare_jail
	fi

	if [ "${emulator}" != "jail" -a -n "${emulator}" -a "${emulator}" != "bhyve" ]; then
		. ${subrdir}/emulator.subr
		init_usermode_emul
		CHROOT_EXEC="/usr/sbin/chroot ${path} /bin/${emulator}"
	else
		CHROOT_EXEC="/usr/sbin/chroot ${path}"
	fi

	${CHROOT_EXEC} /bin/sh <<EOF
${PW_CMD} ${cmd}
EOF
else
	data=
	${PW_CMD} ${cmd}
fi

exit 0
