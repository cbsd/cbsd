#!/usr/bin/env cbsd
#v10.1.1
CIXARG="mode"
CIXOPTARG="jname"
MYDESC="OpenSSH jail helper"
CBSDMODULE="bsdconf"
ADDHELP="
${H3_COLOR}Description${N0_COLOR}:

 Manage sshd service in jail or host system.
 Start, stop, reload or check status of the OpenSSH daemon
 and enable/disable it in rc.conf.

${H3_COLOR}Options${N0_COLOR}:

 ${N2_COLOR}mode=${N0_COLOR}   - action: 'on', 'off', 'reload', 'status'.
 ${N2_COLOR}jname=${N0_COLOR}  - target jail. If omitted, operates on host.

${H3_COLOR}Examples${N0_COLOR}:

 # cbsd ssh jname=jail1 mode=on
 # cbsd ssh jname=jail1 mode=off
 # cbsd ssh jname=jail1 mode=status

${H3_COLOR}See also${N0_COLOR}:

 cbsd service --help
 cbsd sysrc --help

"

. ${subrdir}/nc.subr
. ${cbsdinit}
cixinit

service_cmd()
{
	local _exec_cmd

	[ -z "${1}" ] && return 1

	if [ -z "${jname}" ]; then
		_exec_cmd="/usr/sbin/service sshd one${1}"
	else
		_exec_cmd="${CBSD_CMD} service jname=${jname} sshd one${1}"
	fi

	${_exec_cmd}
}

service_enable()
{
	local _exec_cmd

	[ -z "${1}" ] && return 1

	if [ -z "${jname}" ]; then
		_exec_cmd="${CIX_DISTDIR}/misc/cbsdsysrc"
	else
		_exec_cmd="${CBSD_CMD} sysrc jname=${jname} -q sshd_enable=${1}"
	fi

	${_exec_cmd}
}

case "${mode}" in
	off)
		service_enable "NO"
		service_cmd "stop"
		;;
	on)
		service_enable "YES"
		service_cmd "start"
		;;
	reload)
		service_cmd "reload"
		;;
	status)
		service_cmd "status"
		;;
esac

exit 0
