#!/bin/sh
# full qemu/xen schema
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit 0

mydb="${dbdir}/local.sqlite"

_qemutest=$( ${miscdir}/sqlcli ${mydb} "SELECT COUNT(*) FROM pragma_table_info('qemu') WHERE name = 'uuid'" );
if [ "${_qemutest}" = "0" ]; then
	# reset schema when empty
	_res=$( ${miscdir}/sqlcli ${mydb} "SELECT COUNT(jname) FROM qemu" 2>/dev/null )
	if [ "${_res}" = "0" ]; then
		[ -r "${ftmpdir}/qemu-local.sqlite" ] && ${RM_CMD} -f qemu-local.sqlite
		${miscdir}/sqlcli ${mydb} "DROP TABLE qemu"
	fi
fi

_xentest=$( ${miscdir}/sqlcli ${mydb} "SELECT COUNT(*) FROM pragma_table_info('xen') WHERE name = 'uuid'" );
if [ "${_xentest}" = "0" ]; then
	# reset schema when empty
	_res=$( ${miscdir}/sqlcli ${mydb} "SELECT COUNT(jname) FROM xen" 2>/dev/null )
	if [ "${_res}" = "0" ]; then
		[ -r "${ftmpdir}/xen-local.sqlite" ] && ${RM_CMD} -f xen-local.sqlite
		${miscdir}/sqlcli ${mydb} "DROP TABLE xen"
	fi
fi

exit 0
