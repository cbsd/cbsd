#!/bin/sh
#v41.2.5
# remove placeholder file from share
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit

[ ! -d "${workdir}/share" ] && return

${FIND_CMD} ${workdir}/share/FreeBSD-jail-default-system-skel ${workdir}/share/FreeBSD-jail-puppet-skel ${workdir}/share/FreeBSD-jail-puppet-system-skel ${workdir}/share/FreeBSD-jail-skel ${workdir}/share/FreeBSD-jail-vnet-skel ${workdir}/share/bhyve-system-default ${workdir}/share/jail-system-default ${workdir}/share/qemu-system-default ${workdir}/share/xen-system-default -type f -name placeholder -delete 2>/dev/null

exit 0
