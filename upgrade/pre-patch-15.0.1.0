#!/bin/sh
#v12.1.3
# Update jails/bhyve for sysdir_volume
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit
mydb="${dbdir}/local.sqlite"
unset _test _count
_test=$( ${miscdir}/sqlcli ${mydb} "SELECT COUNT(*) FROM pragma_table_info('jails') WHERE name = 'sysdir_volume';" )
[ "${_test}" = "1" ] && exit 0
${ECHO} "  * ${N1_COLOR}Update jails tables: add sysdir_volume${N0_COLOR}"
${miscdir}/sqlcli ${mydb} "ALTER TABLE jails ADD COLUMN sysdir_volume integer default 0"
