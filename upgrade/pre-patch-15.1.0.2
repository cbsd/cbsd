#!/bin/sh
#v13.0.23
# Update qemu tables for nographic
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit

vms=$( ${miscdir}/sqlcli ${dbdir}/local.sqlite "SELECT jname FROM jails WHERE emulator = 'qemu'" )

for i in ${vms}; do
	mydb="${jailsysdir}/${i}/local.sqlite"
	[ ! -r "${mydb}" ] && continue
	# alter nographic if not exist
	unset _test
	_test=$( ${miscdir}/sqlcli ${mydb} "SELECT COUNT(uuid) FROM settings LIMIT 1" 2>/dev/null )
	[ -n "${_test}" ] && continue
	${ECHO} "  * ${N1_COLOR}Update settings tables: uuid for ${N2_COLOR}${i}${N0_COLOR}"
	${miscdir}/sqlcli ${mydb} "ALTER TABLE settings ADD COLUMN uuid TEXT DEFAULT '0'"
done
