#!/bin/sh
#v15.1.2
# Update jails for syslog
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit 0
mydb="${dbdir}/local.sqlite"
unset _test
_test=$( ${miscdir}/sqlcli ${mydb} "SELECT COUNT(*) FROM pragma_table_info('jails') WHERE name = 'syslog';" )
[ "${_test}" = "1" ] && exit 0
${ECHO} "  * ${N1_COLOR}Update jails tables: add syslog${N0_COLOR}"
${miscdir}/sqlcli ${mydb} "ALTER TABLE jails ADD COLUMN syslog integer default 0"

exit 0
