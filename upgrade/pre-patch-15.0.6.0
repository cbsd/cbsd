#!/bin/sh
#v15.0.6
# Update jails for allow_chflags
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit 0

mydb="${dbdir}/local.sqlite"

unset _test _count
_count=$( ${miscdir}/sqlcli ${mydb} 'SELECT COUNT(jname) FROM jails WHERE emulator="jail"' )
[ "${_count}" = "0" ] && exit 0	# no jails here

_test=$( ${miscdir}/sqlcli ${mydb} "SELECT allow_chflags FROM jails LIMIT 1" )
if [ -z "${_test}" ]; then
	${ECHO} "  * ${N1_COLOR}Update jails tables: add allow_chflags${N0_COLOR}"
	${miscdir}/sqlcli ${mydb} "ALTER TABLE jails ADD COLUMN allow_chflags integer default '0'"
fi

exit 0
