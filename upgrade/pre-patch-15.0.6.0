#!/bin/sh
#v41.2.5
# Update bhyve tables for virtio_console
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit

vms=$( ${miscdir}/sqlcli ${dbdir}/local.sqlite "SELECT jname FROM jails WHERE emulator = 'bhyve'" )

for i in ${vms}; do
	mydb="${jailsysdir}/${i}/local.sqlite"
	[ ! -r "${mydb}" ] && continue
	# alter created if not exist
	unset _test
	# Check if jailnic table exists
	_test=$( ${miscdir}/sqlcli ${mydb} "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='virtio_console';" )
	[ "${_test}" != "0" ] && continue
	${ECHO} "  * ${N1_COLOR}Update bhyve tables: virtio_console for ${N2_COLOR}${i}${N0_COLOR}"
	/usr/local/bin/cbsd ${miscdir}/updatesql ${mydb} ${CIX_DISTDIR}/share/local-bhyve-virtio_console.schema virtio_console
done
