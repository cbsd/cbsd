#!/bin/sh
#v11.1.7
# Update bhyve tables for pcibus
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit

vms=$( ${miscdir}/sqlcli ${dbdir}/local.sqlite "SELECT jname FROM jails WHERE emulator = 'bhyve'" )

# check for pcibus and pcibus_run tables
for j in pcibus pcibus_run; do
	for i in ${vms}; do
		mydb="${jailsysdir}/${i}/local.sqlite"
		[ ! -r "${mydb}" ] && continue
		# alter pcibus/pcibus_run if not exist
		unset _test
		_test=$( ${miscdir}/sqlcli ${mydb} "SELECT name FROM sqlite_master WHERE type='table' AND name='${j}'" )
		[ -n "${_test}" ] && continue
		${ECHO} "  * ${N1_COLOR}Update bhyve tables: ${j} for ${N2_COLOR}${i}${N0_COLOR}"
		/usr/local/bin/cbsd ${miscdir}/updatesql ${mydb} ${CIX_DISTDIR}/share/local-bhyve-pcibus.schema ${j}
	done
done
