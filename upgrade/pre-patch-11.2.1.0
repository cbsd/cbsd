#!/bin/sh
#v11.2.1
# Update bhyvedsk tables for crypto_key column
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit

vms=$( ${miscdir}/sqlcli ${dbdir}/local.sqlite "SELECT jname FROM jails WHERE emulator = 'bhyve'" )

for i in ${vms}; do
	mydb="${jailsysdir}/${i}/local.sqlite"
	[ ! -r "${mydb}" ] && continue
	unset _test
	_test=$( ${miscdir}/sqlcli ${mydb} "SELECT crypto_key FROM bhyvedsk LIMIT 1" )
	[ -n "${_test}" ] && continue
	${ECHO} "  * ${N1_COLOR}Update bhyvedsk tables: crypto_key for ${N2_COLOR}${i}${N0_COLOR}"
	${miscdir}/sqlcli ${mydb} "ALTER TABLE bhyvedsk ADD COLUMN crypto_key text default '0'"
done
