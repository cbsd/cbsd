#!/bin/sh
#v15.0.1
# Update jailnic table for VLAN support: add nic_mtu, nic_flags, nic_vlan_untagged, nic_vlan_tagged columns
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit 0

mydb="${dbdir}/local.sqlite"

_count=$( ${miscdir}/sqlcli ${mydb} "SELECT COUNT(jname) FROM jails WHERE emulator='jail'" )
[ "${_count}" = "0" ] && exit 0

jls=$( ${miscdir}/sqlcli ${mydb} "SELECT jname FROM jails WHERE emulator = 'jail'" )

for jname in ${jls}; do
	jaildb="${jailsysdir}/${jname}/local.sqlite"
	[ ! -r "${jaildb}" ] && continue

	# Check if jailnic table exists
	_table_exists=$( ${miscdir}/sqlcli ${jaildb} "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='jailnic';" )
	[ "${_table_exists}" = "0" ] && continue

	# Check and add nic_mtu
	_test=$( ${miscdir}/sqlcli ${jaildb} "SELECT COUNT(*) FROM pragma_table_info('jailnic') WHERE name = 'nic_mtu';" )
	if [ "${_test}" != "1" ]; then
		${ECHO} "  * ${N1_COLOR}Update ${jname} jailnic: add nic_mtu${N0_COLOR}"
		${miscdir}/sqlcli ${jaildb} "ALTER TABLE jailnic ADD COLUMN nic_mtu INTEGER DEFAULT 0"
	fi

	# Check and add nic_flags
	_test=$( ${miscdir}/sqlcli ${jaildb} "SELECT COUNT(*) FROM pragma_table_info('jailnic') WHERE name = 'nic_flags';" )
	if [ "${_test}" != "1" ]; then
		${ECHO} "  * ${N1_COLOR}Update ${jname} jailnic: add nic_flags${N0_COLOR}"
		${miscdir}/sqlcli ${jaildb} "ALTER TABLE jailnic ADD COLUMN nic_flags TEXT DEFAULT '0'"
	fi

	# Check and add nic_vlan_untagged
	_test=$( ${miscdir}/sqlcli ${jaildb} "SELECT COUNT(*) FROM pragma_table_info('jailnic') WHERE name = 'nic_vlan_untagged';" )
	if [ "${_test}" != "1" ]; then
		${ECHO} "  * ${N1_COLOR}Update ${jname} jailnic: add nic_vlan_untagged${N0_COLOR}"
		${miscdir}/sqlcli ${jaildb} "ALTER TABLE jailnic ADD COLUMN nic_vlan_untagged TEXT DEFAULT '0'"
	fi

	# Check and add nic_vlan_tagged
	_test=$( ${miscdir}/sqlcli ${jaildb} "SELECT COUNT(*) FROM pragma_table_info('jailnic') WHERE name = 'nic_vlan_tagged';" )
	if [ "${_test}" != "1" ]; then
		${ECHO} "  * ${N1_COLOR}Update ${jname} jailnic: add nic_vlan_tagged${N0_COLOR}"
		${miscdir}/sqlcli ${jaildb} "ALTER TABLE jailnic ADD COLUMN nic_vlan_tagged TEXT DEFAULT '0'"
	fi
done

exit 0
