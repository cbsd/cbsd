#!/bin/sh
#v15.0.5
# regenerate bhyve,jail,xen,qemu sqlite cache file
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ -z "${CIX_BIN}" ] && CIX_BIN="/usr/local/bin/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -d "${workdir}/tmp" ] && exit 0

if [ -n "${BHYVE_CMD}" ]; then
	[ -r "${workdir}/tmp/bhyve-local.sqlite" ] && ${RM_CMD} -f "${workdir}/tmp/bhyve-local.sqlite"
	[ -x "${CIX_BIN}" -a -x "${CIX_DISTDIR}/bhyvectl/bsqlite-cache-create" ] && ${CIX_BIN} bsqlite-cache-create file="${workdir}/tmp/bhyve-local.sqlite"
fi
if [ -n "${JAIL_CMD}" ]; then
	[ -r "${workdir}/tmp/jail-local.sqlite" ] && ${RM_CMD} -f "${workdir}/tmp/jail-local.sqlite"
	[ -x "${CIX_BIN}" -a -x "${CIX_DISTDIR}/jailctl/jsqlite-cache-create" ] && ${CIX_BIN} jsqlite-cache-create file="${workdir}/tmp/jail-local.sqlite"
fi
if [ -n "${QEMU_CMD}" ]; then
	[ -r "${workdir}/tmp/qemu-local.sqlite" ] && ${RM_CMD} -f "${workdir}/tmp/qemu-local.sqlite"
	[ -x "${CIX_BIN}" -a -x "${CIX_DISTDIR}/qemuctl/qsqlite-cache-create" ] && ${CIX_BIN} qsqlite-cache-create file="${workdir}/tmp/qemu-local.sqlite"
fi
if [ -n "${XEN_CMD}" ]; then
	[ -r "${workdir}/tmp/xen-local.sqlite" ] && ${RM_CMD} -f "${workdir}/tmp/xen-local.sqlite"
	[ -x "${CIX_BIN}" -a -x "${CIX_DISTDIR}/xenctl/xsqlite-cache-create" ] && ${CIX_BIN} xsqlite-cache-create file="${workdir}/tmp/xen-local.sqlite"
fi

exit 0
