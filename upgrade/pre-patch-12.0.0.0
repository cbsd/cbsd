#!/bin/sh
#v10.0.0
# Update state_time values in bhyve settings when value is not timestampbhyvedsk tables for controller_id column
[ -z "${CIX_DISTDIR}" ] && CIX_DISTDIR="/usr/local/cbsd"
[ ! -r "${CIX_DISTDIR}/subr/cbsdbootstrap.subr" ] && exit 1
. ${CIX_DISTDIR}/subr/cbsdbootstrap.subr || exit 1
test_sql_stuff

[ ! -h "${dbdir}/local.sqlite" ] && exit

vms=$( ${miscdir}/sqlcli ${dbdir}/local.sqlite "SELECT jname FROM jails WHERE emulator = 'bhyve'" )

curr_time=$( date +%s )

for i in ${vms}; do
	mydb="${jailsysdir}/${i}/local.sqlite"
	[ ! -r "${mydb}" ] && continue
	unset _test
	_test=$( ${miscdir}/sqlcli ${mydb} "SELECT COUNT(*) FROM pragma_table_info('settings') WHERE name = 'state_time';" )
	[ "${_test}" = "1" ] && continue
	# if the value contains a space is an invalid value
	part1=
	part2=
	part1=${_test%% *}
	part2=${_test##* }
	[ "${part1}" = "${part2}" -o -z "${part2}" ] && continue
	${ECHO} "  * ${N1_COLOR}Convert bhyve state_time to timestamp value ${curr_time}: ${N2_COLOR}${i}${N0_COLOR}"
	${miscdir}/sqlcli ${mydb} "UPDATE settings SET state_time='${curr_time}'"
done
