#!/usr/bin/env cbsd
#v10.0.3
CBSDMODULE="build"
CIXARG=
CIXOPTARG="platform arch ver target_arch source"
MYDESC="Remove base dir"
ADDHELP="\
  ver=13.1 for 13.1 ver=. for current.\n\
"

. ${subrdir}/nc.subr
readconf buildworld.conf

cixinit

. ${system}
. ${subrdir}/universe.subr

. ${subrdir}/time.subr
gettime st_time

. ${subrdir}/build.subr

init_supported_arch
init_target_arch
init_basedir
init_srcdir
init_kerneldir

unregister_kernel arch="${arch}" ver="${ver}" stable="${stable}" platform="${platform}"
[ -z "${KERNEL_DIR}" -o ! -d "${KERNEL_DIR}" ] && err 1 "${N1_COLOR}no such dir: ${N2_COLOR}${KERNEL_DIR}${N0_COLOR}"

capture _md5 ${miscdir}/cbsd_md5 ${MAKEOBJDIRPREFIX}
LOCKFILE=${ftmpdir}/${_md5}.lock
makelock ${LOCKFILE}
${RM_CMD} -rf ${KERNEL_DIR}

gettime end_time
diff_time=$(( end_time - st_time ))
capture diff_time displaytime ${diff_time}
${ECHO} "${N1_COLOR}${CIX_APP} done ${N2_COLOR}in ${diff_time}${N0_COLOR}"

exit 0
