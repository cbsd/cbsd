#!/usr/bin/env cbsd
#v11.0.0
CBSDMODULE="build"
CIXARG="destdir"
CIXOPTARG="ver arch target_arch basename stable"
MYDESC="Make distribtion for FreeBSD base"
ADDHELP=""

. ${subrdir}/nc.subr
readconf buildworld.conf
. ${subrdir}/universe.subr
cixinit

# By default ver=current version
. ${subrdir}/build.subr

init_distcc
init_notify
init_target_arch
init_srcdir
init_supported_arch
init_basedir

capture _lockhash ${miscdir}/cbsd_md5 ${MAKEOBJDIRPREFIX}
LOCKFILE=${ftmpdir}/${_lockhash}.lock
makelock "$LOCKFILE"

[ -f ${SRC_DIR}/etc/mtree/BSD.root.dist ] && ${MTREE_CMD} -deU -f ${SRC_DIR}/etc/mtree/BSD.root.dist -p ${destdir} >/dev/null
[ -f ${SRC_DIR}/etc/mtree/BSD.usr.dist ] && ${MTREE_CMD} -deU -f ${SRC_DIR}/etc/mtree/BSD.usr.dist -p ${destdir}/usr >/dev/null
[ -f ${SRC_DIR}/etc/mtree/BSD.var.dist ] && ${MTREE_CMD} -deU -f ${SRC_DIR}/etc/mtree/BSD.var.dist -p ${destdir}/var >/dev/null
[ -f ${SRC_DIR}/etc/mtree/BIND.chroot.dist ] && ${MTREE_CMD} -deU -f ${SRC_DIR}/etc/mtree/BIND.chroot.dist -p ${destdir}/var/named >/dev/null
[ -f ${SRC_DIR}/etc/mtree/BSD.sendmail.dist ] && ${MTREE_CMD} -deU -f ${SRC_DIR}/etc/mtree/BSD.sendmail.dist -p ${destdir} >/dev/null
[ -f ${SRC_DIR}/etc/mtree/BSD.include.dist ] && ${MTREE_CMD} -deU -f ${SRC_DIR}/etc/mtree/BSD.include.dist -p ${destdir}/usr/include >/dev/null
[ -f ${SRC_DIR}/etc/mtree/BSD.tests.dist ] && ${MTREE_CMD} -deU -f ${SRC_DIR}/etc/mtree/BSD.tests.dist -p ${destdir}/usr/tests >/dev/null

${MAKE_CMD} -C ${SRC_DIR}/etc distribution DESTDIR=${destdir} TARGET=${arch}
ret=$?

exit ${ret}
