patch_bhyve_usb_passthru()
{
	local _dir _myver=
	set +e

	case "${ver}" in
		14*)
			_myver="14x"
			_dir="bhyve-usb_passthru-14.0"
			;;
		15*)
			_myver="15x"
			_dir="bhyve-usb_passthru-15.0"
			;;
		*)
			${ECHO} "${N1_COLOR}bhyve_usb_passthru patchset for ${N2_COLOR}${ver}${N1_COLOR} unsupported${N0_COLOR}"
			return 0
			;;
	esac

	for _i in patch-${_myver}-usr.sbin-bhyve-Makefile patch-${_myver}-usr.sbin-bhyve-Makefile.depend patch-${_myver}-usr.sbin-bhyve-pci_xhci.c patch-${_myver}-usr.sbin-bhyve-usb_emul.c patch-${_myver}-usr.sbin-bhyve-usb_emul.h patch-${_myver}-usr.sbin-bhyve-usb_mouse.c patch-${_myver}-usr.sbin-bhyve-usb_passthru.c; do
		[ -f "${CIX_DISTDIR}/upgrade/patch/${_dir}/${_i}" ] && cd ${dst}/usr.sbin/bhyve && patch --check -N < ${CIX_DISTDIR}/upgrade/patch/${_dir}/${_i} > /dev/null 2>&1
		[ $? -eq 0 ] && ${ECHO} "${N1_COLOR}apply ${_i} patch for: ${N2_COLOR}bhyve_usb_passthru${N0_COLOR}" && patch < ${CIX_DISTDIR}/upgrade/patch/${_dir}/${_i}
	done

	set -e
}

apply_cbsd_patchset()
{
	case "${ver}" in
		10.0)
			${ECHO} "${N1_COLOR}kmem patchset for ${N2_COLOR}${ver}${N1_COLOR} unsupported${N0_COLOR}"
			return 0
			;;
		10.1)
			${ECHO} "${N1_COLOR}kmem patchset for ${N2_COLOR}${ver}${N1_COLOR} unsupported${N0_COLOR}"
			return 0
			;;
		10.2)
			# support for FreeBSD 10.2+
			patch_kmem102
			;;
		10*)
			# support for FreeBSD 10.2+
			patch_kmem102
			;;
		11.0)
			patch_kmem110
			;;
		11.1)
			patch_kmem111
			;;
		12*)
			patch_kmem120
			;;
	esac

	return 0
}

