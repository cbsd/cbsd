#!/usr/bin/env cbsd
#v10.0.4
CIXARG=""
CIXOPTARG="ver arch basename stable target_arch"
MYDESC="Remove obj-dir"
ADDHELP="ver=9_1 for 9.1 ver=. for current.\n\
stable=1 for RELENG_X\n"

. ${subrdir}/nc.subr

cixinit

over="${ver}"
oarch="${arch}"

. ${subrdir}/build.subr
readconf buildworld.conf
. ${subrdir}/universe.subr

init_distcc
init_notify
init_target_arch
init_srcdir
init_supported_arch
init_make_flags

capture _md5 ${miscdir}/cbsd_md5 ${MAKEOBJDIRPREFIX}
LOCKFILE=${ftmpdir}/${_md5}.lock
makelock ${LOCKFILE}
${ECHO} ${MAKEOBJDIRPREFIX}
[ -d "${MAKEOBJDIRPREFIX}" ] && ${RM_CMD} -rf ${MAKEOBJDIRPREFIX}

exit 0
