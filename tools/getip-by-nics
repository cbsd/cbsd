#!/usr/bin/env cbsd
#v10.1.4
CIXARG="nic"
CIXOPTARG=""
MYDESC="Return first IPv4 on specified interface"

. ${subrdir}/nc.subr

cixinit

ifs=$( ${miscdir}/nics-list -s bridge |${XARGS_CMD} )

A=$( ${IFCONFIG_CMD} "${nic}" 2>/dev/null| ${AWK_CMD} '/inet /{print $2}' 2>/dev/null | /usr/bin/head -n1 2>/dev/null )

[ -z "${A}" ] && err 1 "${A}"

iptype ${A} >/dev/null 2>&1

if [ $? -ne 1 ]; then
	err 1 "Not IPv4: ${A}"
fi

err 0 "${A}"
