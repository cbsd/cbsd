#!/usr/bin/env cbsd
#v10.0.3
CIXARG=""
CIXOPTARG="line"
MYDESC="Show cbsd history command"
ADDHELP="line=N for output only last N commands\n"
EXTHELP="wf_history"
CBSDMODULE="sys"

. ${subrdir}/nc.subr

cixinit

TAIL_OPT=

[ -n "${line}" ] && TAIL_OPT="-n${line}"
[ -r "${workdir}/.cbsd_history" ] && ${TAIL_CMD} ${TAIL_OPT} ${workdir}/.cbsd_history

exit 0
