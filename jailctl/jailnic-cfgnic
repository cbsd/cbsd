#!/usr/bin/env cbsd
CIXARG="jname nic"
CIXPTARG="out"
MYDESC="edit properties for vitual nic of jail vnet"
ADDHELP="out - generate config only (e.g. for non-existance new jail)\n"
CBSDMODULE="jail"

export NOCOLOR=1

. ${subrdir}/nc.subr
. ${tools}
. ${strings}
. ${dialog}
. ${subrdir}/vnet.subr

out=

cixinit

dialog_menu_main()
{
	local _input _retval

	btitle="$DIALOG_BACKTITLE"
	title=" Nic properties ${jname}:${nic_path} "
	hline=
	prompt="${_desc}"

	cbsdsqlro_vars ${mysqlite} \
		"SELECT id,name,nic_order,nic_slot,nic_parent,nic_hwaddr,nic_address,nic_mtu,nic_flags,nic_vlan_untagged,nic_vlan_tagged FROM jailnic WHERE id='${nic}'" \
		nic_id nic_name nic_order nic_slot nic_parent nic_hwaddr nic_address nic_mtu nic_flags nic_vlan_untagged nic_vlan_tagged

	menu_list="
		'nic_name'	'${nic_name}'		'NIC name'
		'nic_parent'	'${nic_parent}'		'NIC parent interface. 0 - auto'
		'nic_hwaddr'	'${nic_hwaddr}'		'NIC Mac address. 0 - auto'
		'nic_address'	'${nic_address}'	'NIC epairA ip4_addr (host side). 0 - disabled'
		'nic_mtu'	'${nic_mtu}'		'NIC MTU size. 0 - inherit from parent'
		'nic_flags'	'${nic_flags}'		'NIC flags: private (bridge isolation)'
		'nic_vlan_untagged'	'${nic_vlan_untagged}'	'Untagged VLAN ID for bridge addm. 0 - disabled'
		'nic_vlan_tagged'	'${nic_vlan_tagged}'	'Tagged VLAN set (comma-sep). 0 - disabled'
		'-'		'-'			''
		'remove'	'remove'		'Detach and remove NIC'
	" # END-QUOTE

	f_dialog_default_fetch defaultitem

	cbsd_menubox_with_help
	local retval=$?

	f_dialog_data_sanitize menu_choice
	f_dialog_menutag_store "$menu_choice"
	f_dialog_default_store "$menu_choice"

	return $retval
}


BSDCFG_LIBE="${CIX_DISTDIR}/share/bsdconfig/cbsd"
[ -z "${CIX_BIN}" ] && CIX_BIN="/usr/local/bin/cbsd"
. ${BSDCFG_LIBE}/include/messages-jailnic.subr

if [ -z "${out}" ]; then
	. ${subrdir}/rcconf.subr
	[ $? -eq 1 ] && err 1 "${N1_COLOR}no such env: ${N2_COLOR}${jname}${N0_COLOR}"
	[ "${emulator}" != "jail" ] && err 1 "${N1_COLOR}not in jail mode${N0_COLOR}"
	mysqlite="${jailsysdir}/${jname}/local.sqlite"
else
	mysqlite="${out}"

	. ${subrdir}/rcconf.subr
	if [ $? -eq 1 ]; then
		# create new database when jail/db not exist
		if [ ! -r ${mysqlite} ]; then
			${CIX_BIN} ${miscdir}/updatesql ${mysqlite} ${CIX_DISTDIR}/share/local-jailnic.schema jailnic
			cbsdsqlrw ${mysqlite} "INSERT INTO jailnic ( name,nic_order,nic_slot,nic_parent,nic_hwaddr,nic_address,nic_mtu,nic_flags,nic_vlan_untagged,nic_vlan_tagged ) VALUES ( 'eth0','0','0','auto','${nic_hwaddr}','${nic_address}','0','0','0','0' )"
		fi
	fi
fi

. ${BSDCFG_LIBE}/include/jailnic.subr
. ${subrdir}/settings-tui-jail.subr
. ${subrdir}/settings-tui-jail.subr
. ${subrdir}/settings-tui.subr

while :; do
	dialog_menu_main || break

	[ -z "${mtag}" ] && break

	_command=
	case "${mtag}" in
		?" $msg_exit")
			break
			;;
		"-"|nic_nameslot|size|nic_type)
			continue
			;;
		nic_hwaddr)
			get_construct_nic_hwaddr && update_nic_hwaddr ${nic_id}
			;;
		nic_address)
			get_construct_nic_address && update_nic_address ${nic_id}
			;;
		nic_parent)
			get_nic_parent && update_nic_parent ${nic_id}
			;;
		nic_mtu)
			get_construct_nic_mtu && update_nic_mtu ${nic_id}
			;;
		nic_flags)
			get_construct_nic_flags && update_nic_flags ${nic_id}
			;;
		nic_vlan_untagged)
			get_construct_nic_vlan_untagged && update_nic_vlan_untagged ${nic_id}
			;;
		nic_vlan_tagged)
			get_construct_nic_vlan_tagged && update_nic_vlan_tagged ${nic_id}
			;;
		remove)
			if getyesno "Detach and remove NIC from ${jname} jail?"; then
				jail_remove_nic "${nic_id}"
				exit 0
			fi
			;;
		*)
			;;
	esac
done

exit 0
