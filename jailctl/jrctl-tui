#!/usr/bin/env cbsd
#v11.0.10
CBSDMODULE="jail"
CIXARG="jname"
CIXOPTARG=""
MYDESC="Dialog based UI for RACCR/RCTL"

. ${subrdir}/nc.subr
. ${tools}
. ${strings}

[ -z "${1}" ] && select_jail_by_list -s "List of local jails:" -r 0
cixinit

. ${subrdir}/rcconf.subr
[ $? -eq 1 ] && err 1 "${N1_COLOR}No such jail: ${N2_COLOR}${jname}${N0_COLOR}"

forms module=jrctl jname=${jname} updcol=cur
