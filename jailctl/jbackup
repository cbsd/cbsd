#!/usr/bin/env cbsd
#v10.1.5
CIXARG="jname node"
CIXOPTARG=""
MYDESC="Backup jail to slave node with slave status"
ADDHELP="
${H3_COLOR}Description${N0_COLOR}:

 Backup a jail to a remote slave node using j2prepare + j2slave.
 Runs under lockf to prevent concurrent backups of the same jail.

${H3_COLOR}Options${N0_COLOR}:

 ${N2_COLOR}jname=${N0_COLOR} - target jail name;
 ${N2_COLOR}node=${N0_COLOR}  - target CBSD node;

${H3_COLOR}Examples${N0_COLOR}:

 # cbsd jbackup jname=myjail node=node2

${H3_COLOR}See also${N0_COLOR}:

  cbsd j2prepare --help
  cbsd j2slave --help

"

. ${subrdir}/nc.subr
. ${strings}
. ${tools}
cixinit

. ${subrdir}/rcconf.subr
[ $? -eq 1 ] && err 1 "${N1_COLOR}No such jail: ${N2_COLOR}${jname}${N0_COLOR}"

cbsdlogger NOTICE ${CIX_APP}: perform j2prepare
/usr/bin/lockf -s -t0 ${ftmpdir}/j2prepae_$$.lock j2prepare node=${node} jname=${jname} || err 1 "${N1_COLOR}j2prepare failed for ${N2_COLOR}${jname}${N1_COLOR} to ${N2_COLOR}${node}${N0_COLOR}"
cbsdlogger NOTICE ${CIX_APP}: perform j2slave
/usr/bin/lockf -s -t0 ${ftmpdir}/j2slave_$$.lock j2slave node=${node} jname=${jname} || err 1 "${N1_COLOR}j2slave failed for ${N2_COLOR}${jname}${N1_COLOR} to ${N2_COLOR}${node}${N0_COLOR}"
