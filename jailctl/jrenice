#!/usr/bin/env cbsd
#v11.2.1
CBSDMODULE="jail"
CIXARG="jname"
CIXOPTARG="nice"
MYDESC="Re-nice jail processes on-the-fly"
ADDHELP="${H3_COLOR}Description${N0_COLOR}:
  Re-nice jail processes on-the-fly.

${H3_COLOR}Options${N0_COLOR}:
  nice=<value>  ; set nice value (e.g. 10, -5); if omitted, use value from RCTL database

${H3_COLOR}Examples${N0_COLOR}:
  cbsd jrenice jname=jail1 nice=10
  cbsd jrenice jname=jail1                 ; apply nice from RCTL database

${H3_COLOR}See also${N0_COLOR}:
  brenice - equivalent for bhyve VMs
"

. ${subrdir}/nc.subr
. ${strings}
. ${subrdir}/tools.subr

cixinit

emulator="jail" # for jname_is_multiple
jname_is_multiple

if [ -n "${jail_list}" ]; then
	TMP_JLIST="${jail_list}"
else
	TMP_JLIST=$*
fi

JLIST=

# check for actual vm list in arg list
jail_num=0
for i in ${TMP_JLIST}; do
	capture exist cbsdsqlro local SELECT jname FROM jails WHERE jname=\"${i}\" AND emulator=\"${emulator}\" LIMIT 1
	if [ -n "${exist}" ]; then
		JLIST="${exist} ${JLIST}"
		jail_num=$(( jail_num + 1 ))
	fi
done

# this is multiple list, split it by parallel bstop execution
if [ ${jail_num} -gt 1 ]; then
	cbsdlogger NOTICE ${CIX_APP}: executing for multiple jrenice: ${JLIST}
	new_arg=

	for i in $*; do
		capture _is_jname substr --pos=0 --len=5 --str=${i}
		[ "${_is_jname}" = "jname" ] && continue
		new_arg="${new_arg} ${i}"
	done

	for jname in ${JLIST}; do
		jrenice jname=${jname} ${new_arg}
	done
	exit 0
fi


. ${subrdir}/rcconf.subr
[ "${emulator}" != "jail" ] && log_err 1 "${N1_COLOR}Not in jail emulator: ${N2_COLOR}${emulator}${N0_COLOR}"
[ ${jid} -eq 0 ] && exit 0

if [ -z "${nice}" ]; then
	_formfile="${jailsysdir}/${jname}/helpers/jrctl.sqlite"
	[ -r "${_formfile}" ] && capture nice cbsdsqlro ${_formfile} "SELECT cur FROM forms WHERE param=\"nice\""
	# just reset
	[ -z "${nice}" ] && nice="0"
fi

pid_count=0
jpid_list=

capture _ps_out /bin/ps -axfw -w -o pid,jid,state
while read _pid _jid _state; do
	[ "${jid}" != "${_jid}" ] && continue
	pid_count=$(( pid_count + 1 ))
	case "${_state}" in
		*T*) pid_count=$(( pid_count - 1 )) ;;
	esac
	jpid_list="${jpid_list} ${_pid}"
done <<< "${_ps_out}"

cbsdlogger NOTICE ${CIX_APP}: re-nice ${nice} to jail ${jname} pids: ${jpid_list}
/usr/bin/renice ${nice} -p ${jpid_list}

exit 0
