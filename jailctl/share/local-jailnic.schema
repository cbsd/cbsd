# Default SQL scheme for DB local::jailnic
MYCOL="id name nic_order nic_slot nic_parent nic_hwaddr nic_address nic_persistent nic_mtu nic_flags nic_vlan_untagged nic_vlan_tagged"

id="INTEGER PRIMARY KEY AUTOINCREMENT"
name="VARCHAR(64) UNIQUE DEFAULT ''"
nic_order="integer default 0"
nic_slot="text default 0"
nic_parent="text default \"auto\""		# upstream
nic_hwaddr="text default 0"			# MAC addr
nic_address="text default 0"			# IP ADDRESS from hoster side
nic_persistent="integer default 0"		# 1 mean persistent nic (no managed by CBSD)
nic_mtu="integer default 0"			# MTU size, 0 - inherit from parent
nic_flags="text default \"0\""			# comma-separated flags, e.g: private
nic_vlan_untagged="text default \"0\""		# untagged VLAN ID for bridge addm, 0 - disabled
nic_vlan_tagged="text default \"0\""		# tagged VLAN set for bridge addm (comma-separated), 0 - disabled

CONSTRAINT=""

INITDB=""
