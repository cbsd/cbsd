#!/usr/local/bin/cbsd
#v11.0.10
CIXARG=""
CIXOPTARG="jname invert"
MYDESC="Return jail ID in output and jail existance as error code (0: no jail, 1: jail exist)"
CBSDMODULE="jail"

. ${subrdir}/nc.subr
cixinit
if [ -n "${invert}" ]; then
	EXIST="0"
	NOT_EXIST="1"
else
	EXIST="1"
	NOT_EXIST="0"
fi

if [ -z "${jname}" ]; then
	jname="${CIX_OTHER_ARGS}"
fi

[ -z "${jname}" ] && exit ${NOT_EXIST}

. ${subrdir}/rcconf.subr
[ $? -eq 1 ] && exit ${NOT_EXIST}

# jail exist
echo "${myjid}"

exit ${EXIST}
