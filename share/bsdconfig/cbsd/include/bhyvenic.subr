load_nic_info()
{
	nic_last_id=1
	local sqldelimer=" "

	unset niclist

	for last_nic in $( ${SEQ_CMD} 1 16 ); do
		unset nic_order${last_nic}
		unset nic_id${last_nic}
		unset nic_order${last_nic}
		unset nic_driver${last_nic}
		unset nic_slot${last_nic}
		unset nic_type${last_nic}
		unset nic_parent${last_nic}
		unset nic_hwaddr${last_nic}
		unset nic_flags${last_nic}
		unset nic_vlan_untagged${last_nic}
		unset nic_vlan_tagged${last_nic}
	done

	eval $( cbsdsqlro ${jailsysdir}/${jname}/local.sqlite "SELECT id,nic_order,nic_driver,nic_slot,nic_type,nic_parent,nic_hwaddr,nic_flags,nic_vlan_untagged,nic_vlan_tagged FROM bhyvenic WHERE jname='${jname}'" | while read nic_id nic_order nic_driver nic_slot nic_type nic_parent nic_hwaddr nic_flags nic_vlan_untagged nic_vlan_tagged; do
		echo "export nic_id${nic_last_id}='${nic_id}'"
		echo "export nic_order${nic_last_id}='${nic_order}'"
		echo "export nic_driver${nic_last_id}='${nic_driver}'"
		echo "export nic_slot${nic_last_id}='${nic_slot}'"
		echo "export nic_type${nic_last_id}='${nic_type}'"
		echo "export nic_parent${nic_last_id}='${nic_parent}'"
		echo "export nic_hwaddr${nic_last_id}='${nic_hwaddr}'"
		echo "export nic_flags${nic_last_id}='${nic_flags}'"
		echo "export nic_vlan_untagged${nic_last_id}='${nic_vlan_untagged}'"
		echo "export nic_vlan_tagged${nic_last_id}='${nic_vlan_tagged}'"
		nic_last_id=$(( nic_last_id + 1 ))
	done ) || err 1 "${N1_COLOR}Error while create disk map${N0_COLOR}"
}

# form for $nic_vlan_untagged
get_construct_nic_vlan_untagged()
{
	local _input= _message="Untagged VLAN ID for bridge member (ifconfig bridge addm interface untagged <vlan-id>). Set 0 to disable."

	f_dialog_input _input "Input untagged VLAN ID (0 - disabled)" "${nic_vlan_untagged}" \
		"$_message" || return 1

	[ -n "${_input}" ] && nic_vlan_untagged="${_input}"
}

# form for $nic_vlan_tagged
get_construct_nic_vlan_tagged()
{
	local _input= _message="Tagged VLAN set for bridge member (ifconfig bridge addm interface tagged <vlan-set>). Comma-separated list, e.g: 100,200,300. Set 0 to disable."

	f_dialog_input _input "Input tagged VLAN set (comma-separated, 0 - disabled)" "${nic_vlan_tagged}" \
		"$_message" || return 1

	[ -n "${_input}" ] && nic_vlan_tagged="${_input}"
}

# form for $nic_driver
get_nic_driver()
{
	local _input= _retval=

	local _par="${1}"
	local title=" NIC driver for ${mtag} "
	hline=
	local menu_list=

	local baseelf=$( ${miscdir}/elf_tables --ver /bin/sh 2>/dev/null )

	if [ ${baseelf} -gt 1100122 ]; then
		menu_list="
		'e1000'		'Intel e82545 network interface'	'Intel e82545 network interface'
		'vtnet'		'Virtio Ethernet driver'		'Virtio network device'
		" # END-QUOTE
	else
		menu_list="'e1000'		'Intel e82545 network interface'	'Intel e82545 network interface'"
	fi

	local height width rows
	eval f_dialog_menu_with_help_size height width rows \
		'\$title'  \
		'\$btitle' \
		'\$prompt' \
		'\$hline'  \
		$menu_list

	height=$(( height + 1 ))

	[ -n "${nic_driver}" ] && local defaultitem="${nic_driver}"

	local menu_choice
	menu_choice=$( eval $DIALOG \
		--clear                                 \
		--title '\$title'                     \
		--backtitle '\$btitle'                \
		--hline '\$hline'                     \
		--item-help                             \
		--ok-label '\$msg_ok'                 \
		--cancel-label 'Exit'                 \
		${cbsd_help}                            \
		${USE_XDIALOG:+--help ''}             \
		--default-item '\$defaultitem'        \
		--menu ' \$prompt '                   \
		$height $width $rows                    \
		$menu_list                              \
		2>&1 >&$DIALOG_TERMINAL_PASSTHRU_FD
	)

	local retval=$?
	f_dialog_data_sanitize menu_choice
	f_dialog_menutag_store "$menu_choice"

	[ $retval -eq $DIALOG_OK ] && nic_driver="${menu_choice}"

	return $retval
}

# form for $vale_name
get_vale_switch()
{
	local _input= _retval=

	. ${subrdir}/settings-tui.subr

	local menu_list=$( cbsdsqlro local SELECT name FROM vale | while read name; do
		echo "'${name}' '${name}'        'Switch named ${name}'"
	done ) || err 1 "${N1_COLOR}Error while create vale map${N0_COLOR}"

	[ -z "${menu_list}" ] && menu_list="''  'no data'       ''"

	cbsd_menubox
	retval=$?

	vale_name=

	case $retval in
		${DIALOG_OK})
			nic_parent="${mtag}"
			return 0
			;;
	esac

	return 1
}

# form for new nic
# -d driver -f flags -r ratelimit -t type -h hwaddr -a address -p nic_parent -z nic_persistent -u nic_vlan_untagged -T nic_vlan_tagged
add_nic()
{
	local controller=
	local nic=
	local size=
	local newnic=
	local nic_persistent=
	local ratelimit=

	while getopts "a:d:f:r:t:h:p:z:u:T:" opt; do
		case "${opt}" in
			a) nic_address="${OPTARG}" ;;
			d) nic_driver="${OPTARG}" ;;
			f) nic_flags="${OPTARG}" ;;
			r) nic_ratelimit="${OPTARG}" ;;
			t) nic_type="${OPTARG}" ;;
			h) nic_hwaddr="${OPTARG}" ;;
			p) nic_parent="${OPTARG}" ;;
			z) nic_persistent="${OPTARG}" ;;
			u) nic_vlan_untagged="${OPTARG}" ;;
			T) nic_vlan_tagged="${OPTARG}" ;;
		esac
		shift $(($OPTIND - 1))
	done

	[ -z "${nic_address}" ] && nic_address="0"
	[ -z "${nic_parent}" ] && nic_parent="auto"
	[ -z "${nic_ratelimit}" ] && nic_ratelimit="0"
	[ -z "${nic_driver}" ] && err 1 "${N1_COLOR}Empty nic_driver${N0_COLOR}"
	[ -z "${nic_type}" ] && err 1 "${N1_COLOR}Empty nic_type${N0_COLOR}"
	[ -z "${nic_hwaddr}" ] && err 1 "${N1_COLOR}Empty nic_hwaddr${N0_COLOR}"
	[ -z "${nic_persistent}" ] && nic_parent="0"
	[ -z "${nic_flags}" ] && nic_flags="0"
	[ -z "${nic_vlan_untagged}" ] && nic_vlan_untagged="0"
	[ -z "${nic_vlan_tagged}" ] && nic_vlan_tagged="0"

	if [ -n "${driver}" ]; then
		cbsdsqlrw ${jailsysdir}/${jname}/local.sqlite "INSERT INTO bhyvenic ( jname,nic_driver,nic_type,nic_parent,nic_hwaddr,nic_address,nic_persistent,nic_ratelimit,nic_flags,nic_vlan_untagged,nic_vlan_tagged ) VALUES ( '${jname}','${nic_driver}','${nic_type}','${nic_parent}', '${nic_hwaddr}', '${nic_address}', '${nic_persistent}', '${nic_ratelimit}', '${nic_flags}', '${nic_vlan_untagged}', '${nic_vlan_tagged}' )"
	else
		cbsdsqlrw ${jailsysdir}/${jname}/local.sqlite "INSERT INTO bhyvenic ( jname,nic_type,nic_parent,nic_hwaddr,nic_address,nic_persistent,nic_ratelimit,nic_flags,nic_vlan_untagged,nic_vlan_tagged ) VALUES ( '${jname}','${nic_type}','${nic_parent}', '${nic_hwaddr}', '${nic_address}', '${nic_persistent}', '${nic_ratelimit}', '${nic_flags}', '${nic_vlan_untagged}', '${nic_vlan_tagged}' )"
	fi

	return 0
}


# update hwaddr by nic id
# $nic_hwaddr must be set
update_nic_hwaddr()
{
	local nic="${1}"; shift
	[ -z "${nic_hwaddr}" ] && return 0
	[ -z "${jname}" -o -z "${nic}" ] && return 0

	cbsdsqlrw ${jailsysdir}/${jname}/local.sqlite "UPDATE bhyvenic SET nic_hwaddr='${nic_hwaddr}' WHERE id='${nic}'"

	return 0
}

