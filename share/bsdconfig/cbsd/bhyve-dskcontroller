#!/usr/bin/env cbsd
# dialog_menu_main
#
# Display the dialog(1)-based application main menu.
#
dialog_menu_main()
{
	local _title="$DIALOG_TITLE"
	local _btitle="$DIALOG_BACKTITLE"
	local _prompt=" Virtual Machine: ${jname} "
	local _menu_list="
		'A ${msg_add_new_ctr}'	'${msg_add_new_ctr_desc}'	'Add and configure new virtual controller'
		'-'	'-'	''
	" # END-QUOTE
	local _defaultitem=
	local _hline="$hline_arrows_tab_enter"

	local _n=1

	for _last_ctr in $( ${SEQ_CMD} 1 16 ); do
		unset id name type count cache
		eval id="\$ctr_id${_last_ctr}"
		[ -z "${id}" ] && break
		eval ctr_name="\$ctr_name${_last_ctr}"
		eval ctr_type="\$ctr_type${_last_ctr}"
		eval ctr_count="\$ctr_count${_last_ctr}"
		eval ctr_cache="\$ctr_cache${_last_ctr}"

		_menu_list="${_menu_list} '${_n} ${ctr_name}'	'${ctr_type}'	'count=${ctr_count},cache=${ctr_cache}'"
		_n=$(( _n + 1 ))
	done

	eval f_dialog_menu_with_help_size height width rows \
		\"\$_title\"  \
		\"\$_btitle\" \
		\"\$_prompt\" \
		\"\$_hline\"  \
		$_menu_list

	height=$(( height + 1 ))

	# Obtain default-item from previously stored selection
	f_dialog_default_fetch _defaultitem

	local _menu_choice
	_menu_choice=$( eval $DIALOG \
		--clear                                 \
		--title \"\$_title\"                    \
		--backtitle \"\$_btitle\"               \
		--hline \"\$_hline\"                    \
		--item-help                             \
		--ok-label \"\$msg_ok\"                 \
		--cancel-label \"Exit\"                 \
		${cbsd_help}                            \
		${USE_XDIALOG:+--help \"\"}             \
		--default-item \"\$_defaultitem\"       \
		--menu \" \$_prompt \"                  \
		$height $width $rows                    \
		$_menu_list                             \
		2>&1 >&$DIALOG_TERMINAL_PASSTHRU_FD
	)

	local _retval=$?
	f_dialog_data_sanitize _menu_choice
	f_dialog_menutag_store "$_menu_choice"

	# Only update default-item on success
	[ $_retval -eq $DIALOG_OK ] && f_dialog_default_store "$_menu_choice"
	return $_retval
}

find_first_free_ctr_id()
{
	local _last_ctr _res

	capture _last_ctr cbsdsqlro ${jailsysdir}/${jname}/local.sqlite 'SELECT COUNT(id) FROM bhyve_dskcontroller'
	[ -z "${_last_ctr}" ] && _last_ctr="0"
	_last_ctr=$(( _last_ctr + 1 ))
	echo "${_last_ctr}"
}

############################################################ MAIN
export NOCOLOR=1

CIXARG="jname"
CIXOPTARG=""
MYDESC="Bhyve controller dialog"
CBSDMODULE="bhyve"

globalconf="${CIX_DISTDIR}/cbsd.conf";

set -e
. ${globalconf}
set +e

. ${subrdir}/nc.subr
. ${strings}
. ${tools}
cixinit

. ${subrdir}/bsdconfig.subr
. ${BSDCFG_LIBE}/${APP_DIR}/include/messages-bhyve-dskcontroller.subr

. ${subrdir}/rcconf.subr
[ $? -eq 1 ] && err 1 "${N1_COLOR}No such VM: ${N2_COLOR}${jname}${N0_COLOR}"
[ "${emulator}" != "bhyve" ] && err 1 "${N1_COLOR}Not in bhyve mode${N0_COLOR}"

. ${CIX_DISTDIR}/share/bhyve/bhyve-controller.subr

# Incorporate rc-file if it exists
[ -f "$HOME/.bsdconfigrc" ] && f_include "$HOME/.bsdconfigrc"

#
# Process command-line arguments
#
while getopts h$GETOPTS_STDARGS flag; do
	case "$flag" in
	h|\?) f_usage $BSDCFG_LIBE/$APP_DIR/USAGE "PROGRAM_NAME" "$pgm" ;;
	esac
done
shift $(( OPTIND - 1 ))

#
# Initialize
#
f_dialog_title " $msg_configure_bhyvecontroller "
f_dialog_backtitle "${ipgm:+bsdconfig }$pgm"

#
# Loop over the main menu until we've accomplished what we came here to do
#
while :; do
	load_ctr_info
	dialog_menu_main || break
	f_dialog_menutag_fetch _mtag

	[ -z "${_mtag}" ] && exit $SUCCESS

	_command=

	case "$_mtag" in
		?" $msg_exit") break ;;
		?" $msg_add_new_ctr")
			_last_ctr=$( find_first_free_ctr_id )
			_ctr="ctr${_last_ctr}"
			_command="bhyve-newcontroller jname=${jname} ctr=${_ctr}"
			;;
		*)
			[ "${_mtag}" = "-" ] && continue
			_ctr=${_mtag##* }
			_command="bhyvedsk-cfgcontroller jname=${jname} ctr=${_ctr}"
			;;
	esac

	if [ "${_command}" ]; then
		$BSDCFG_LIBE/$APP_DIR/${_command} ${USE_XDIALOG:+-X}
	fi

done

return $SUCCESS

