#!/usr/bin/env cbsd
#v9.2.2
CIXARG="jname"
CIXOPTARG=""
MYDESC="Chown for rc.conf/fstab/system directory to cbsd user"

. ${subrdir}/nc.subr
cixinit

. ${subrdir}/rcconf.subr

jstatus jname=${jname} > /dev/null 2>&1
_res=$?

case ${_res} in
	0)
		err 1 "${N1_COLOR}No such jail: ${N2_COLOR}${jname}${N0_COLOR}"
	;;
	1)
		JAILFSTAB=${mount_fstab}
	;;
	*)
		err 1 "${N1_COLOR}Unknown result from jstatus: ${N2_COLOR}${_res}${N0_COLOR}"
	;;
esac

[ -f "${JAILFSTAB}" ] && chown ${cbsduser} ${JAILFSTAB}
[ -d "${jailsysdir}/${jname}" ] && find "${jailsysdir}/${jname}" -exec chown ${cbsduser} {} +

exit 0
