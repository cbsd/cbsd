	local OLD_FILES= OLD_DIRS=
	. ${CIX_DISTDIR}/ObsoleteFiles

	# append for modules Obsolete cmd part
	if [ -f "${etcdir}/modules.conf" ]; then
		for i in $( ${CAT_CMD} ${etcdir}/modules.conf ); do
