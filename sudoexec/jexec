#!/usr/bin/env cbsd
# shellcheck shell=sh disable=2034,2154,1090,2166,3037,2086,1091
#v12.1.7
CIXARG=""
CIXOPTARG="cmd dir environment jname shell user"
MYDESC="Execute command inside jail"
ADDHELP="
${H3_COLOR}Description${N0_COLOR}:

 Run the command in the container from the master environment via jexec command
 If you are in the CBSDfile directory, these environments will always have priority.

 Words after the options, or after --, are the program and its arguments inside
 the jail. They are passed through unchanged, including spaces, newlines and "=".
 When cmd= is set, those words are parameters of that script and are not joined
 into it. A single jail passes standard input to the program. Several jails do
 not accept standard input. With no program and no cmd=, /bin/sh reads standard input.

 This script supports the reserved word WHERE, which allows you to write SQL condition,
 please see 'schema jails' in ~cbsd/var/db/local SQLite3 DB for flexible queries.

${H3_COLOR}Options${N0_COLOR}:

 ${N2_COLOR}cmd${N0_COLOR}         - shell script. Arguments are its parameters and are not joined.
               shell=auto runs cmd via /bin/sh -c when it has metacharacters;
 ${N2_COLOR}dir${N0_COLOR}         - change current directory in jail before execute ( default: '/' );
 ${N2_COLOR}environment${N0_COLOR} - pass environment. Repeat the option for each variable:
               environment=\"FOO=bar\" environment=\"VAR1=boo\"
               A value may contain spaces, or be a path to an env file;
 ${N2_COLOR}jname${N0_COLOR}       - target jail. If jail='*' or jail='pri*' then execute command on all
               jails or in jails whose names begin with 'pri', e.g. 'prison1', 'prisonX'...;
 ${N2_COLOR}shell${N0_COLOR}       - no, auto (default), or a path.
               no executes the program as given.
               auto decides from cmd.
               shell=/bin/bash is that shell: /bin/bash -c \"\$cmd\" plus parameters;
 ${N2_COLOR}user${N0_COLOR}        - execute a command as another user. Default is 'root';

${H3_COLOR}Examples${N0_COLOR}:

 # cbsd jexec ls -la /bin/ WHERE astart=1 AND ver=15.0
 # cbsd jexec jname=test dir=/tmp pwd
 # cbsd jexec jname=test user=nobody whoami
 # cbsd jexec jname=test <<EOF
pwd
hostname
ls -la
env ASSUME_ALWAYS_YES=yes pkg bootstrap -f
EOF

  # env ASSUME_ALWAYS_YES=yes cbsd jexec jname=test pkg bootstrap -f
  # cbsd jexec jname=test cmd=\"pwd; hostname; env ASSUME_ALWAYS_YES=yes pkg bootstrap -f\"
  # cbsd jexec jname=test -- printf '%s' 'hello world'
  # printf 'hello\\n' | cbsd jexec jname=test -- cat
  # cbsd jexec environment=\"VAR1=var1\" environment=\"VAR2=var2\" jname='*' -- /bin/sh -c \"hostname; ls -la\"

${H3_COLOR}See also${N0_COLOR}:

 cbsd jlogin --help

"
CBSDMODULE="jail"
EXTHELP="wf_jexec"

. ${subrdir}/nc.subr
cloud_api=0
dir=
odir=
shell=
oshell=
ojname=
environment=
oenvironment=
user=
ouser=

. ${tools}
# environment= may be repeated; cixinit -j keeps every value in CIX_JSON_ARGS.
CIXMULTIARG="environment"
cixinit -j

if [ -z "${jname}" -a -n "${ojname}" ]; then
	# inherit jname env
	jname="${ojname}"
fi

Makefile="${CIX_PWD}/CBSDfile"
if [ -r "${Makefile}" ]; then
	[ -z "${CBSDFILE_RECURSIVE}" ] && ${ECHO} "${N1_COLOR}found CBSDfile: ${N2_COLOR}${Makefile}${N0_COLOR}" 1>&2
	. ${Makefile}
	jail_list=$( ${GREP_CMD} -E '^jail_[a-zA-Z0-9_@%:][-a-zA-Z0-9_@%:]*\(\)$' ${Makefile} | ${XARGS_CMD} | ${TR_CMD} -d "()" | ${SED_CMD} s#jail_##g )
	[ -z "${jail_list}" ] && err 1 "${N1_COLOR}${CIX_APP}: no jail found${N0_COLOR}"
	[ -z "${jname}" ] && jname="${jail_list}"
	[ -z "${ojname}" ] && ojname="${jname}"

	if [ -n "${CLOUD_URL}" -a -n "${CLOUD_KEY}" ]; then
		cbsd_api=1
	else
		cbsd_api=0
	fi
else
	cbsd_api=0
fi

if [ -z "${jname}" -a -n "${CIXINIT_SQL_CONDITION}" ]; then
	cbsdsqlro_vars local "SELECT jname FROM jails WHERE ${CIXINIT_SQL_CONDITION}" jail_list
fi
if [ -z "${jail_list}" ]; then
	if [ ${cbsd_api} -eq 0 ]; then
		# todo: multiple bexec via all_bhyve_list?
		[ -z "${jname}" ] && err 1 "${N1_COLOR}${CIX_APP}: give me jname${N0_COLOR}"
	fi
fi

if [ -n "${ojname}" ]; then
	jname="${ojname}"
	unset jail_list
fi

emulator="jail"		# for jname_is_multiple
[ -z "${jail_list}" ] && jname_is_multiple	# import jail_list if jname is mask

_global_ret=0
_jexec_argc="${CIX_JSON_ARGS@.argv|length}"
[ -z "${_jexec_argc}" ] && _jexec_argc=0

jexec_defaults()
{
	[ -n "${ouser}" ] && user="${ouser}"
	[ -z "${user}" ] && user="root"
	[ -n "${oshell}" ] && shell="${oshell}"
	[ -z "${shell}" ] && shell="auto"
	[ -n "${odir}" ] && dir="${odir}"
	[ -z "${dir}" ] && dir="/"
}

# ']' is first so it belongs to the class. Same set as jexec_env shell_meta().
_jexec_meta=$(printf '%b' '] \t\n|&;<>()$`"\047\\*?[{}!~')

# A pipe or a file on stdin cannot be shared by several jails, and reading it
# here would consume it before we know whether the command wants it.
if [ -n "${jail_list}" ] && { [ -p /dev/stdin ] || [ -f /dev/stdin ]; }; then
	err 1 "${N1_COLOR}${CIX_APP}: stdin is not supported for multiple jails${N0_COLOR}"
fi

if [ -n "${jail_list}" ]; then
	. ${subrdir}/multiple.subr

	${ECHO} "${N1_COLOR}Hint: Press ${N2_COLOR}'Ctrl+t'${N1_COLOR} to see last logfile line for active task${N0_COLOR}" 1>&2
	task_owner="jexec_multiple"

	task_id=
	task_id_cur=

	# The task daemon does not inherit this process. The per-jail cixinit -j
	# reads CIX_JSON_ARGS back and only jname= is applied on top, so argv,
	# environment and the other named parameters stay intact.
	export CIX_JSON_ARGS
	for jname in ${jail_list}; do
		. ${subrdir}/rcconf.subr
		[ ${myjid} -eq 0 ] && continue

		_jsonfile="${tmpdir}/jexec.${jname}.$$.json"
		_cbsd_bin="${CIX_BIN:-/usr/local/bin/cbsd}"
		printf '%s\n' "${CIX_JSON_ARGS}" > "${_jsonfile}"
		_taskcmd="export NOCOLOR=1; CIX_JSON_ARGS=\"\$(cat '${_jsonfile}')\"; export CIX_JSON_ARGS; rm -f '${_jsonfile}'; exec ${_cbsd_bin} jexec jname=${jname}"
		capture task_id_cur task mode=new logfile=${tmpdir}/${task_owner}.${jname}.log.$$ client_id=${jname} autoflush=0 owner=${task_owner} "${_taskcmd}"
		task_id="${task_id} ${task_id_cur}"
	done

	capture multiple_task_id_all ${TR_CMD} " " "," <<< "${task_id}"
	sleep 1
	multiple_processing_spawn -o ${task_owner} -n "jexec"
	echo
	exit 0
fi
if [ ${cbsd_api} -eq 1 ]; then
	_njails=0
	for _j in ${all_jail_list}; do
		_njails=$(( _njails + 1 ))
	done
	if [ "${_njails}" -gt 1 ] && { [ -p /dev/stdin ] || [ -f /dev/stdin ]; }; then
		err 1 "${N1_COLOR}${CIX_APP}: stdin is not supported for multiple jails${N0_COLOR}"
	fi
	[ -z "${CURL_CMD}" ] && capture CURL_CMD which curl
	[ -z "${CURL_CMD}" ] && err 1 "${N1_COLOR}cloud up requires curl, please install: ${N2_COLOR}pkg install -y curl${N0_COLOR}"
	[ -z "${CBSDFILE_RECURSIVE}" ] && ${ECHO} "${N1_COLOR}main cloud api: ${N2_COLOR}${CLOUD_URL}${N0_COLOR}" 1>&2
	capture _cid ${miscdir}/cbsd_md5 "${CLOUD_KEY}"

	# restore scope in jname=XXX specified
	[ -n "${ojname}" ] && all_jail_list="${ojname}"

	for jname in ${all_jail_list}; do
		capture _ssh ${CURL_CMD} --no-progress-meter -H "cid:${_cid}" ${CLOUD_URL}/api/v1/status/${jname} 2>&1
		_ret=$?
		if [ ${_ret} -ne 0 ]; then
			${ECHO} "${N1_COLOR}${CIX_APP} error: curl error1: ${N2_COLOR}${_ssh}${N0_COLOR}"
			${ECHO} "${CURL_CMD} --no-progress-meter -H \"cid:XXXXX\" ${CLOUD_URL}/api/v1/status/${jname}"
			_global_ret=$(( _global_ret + 1 ))
			continue
		fi

		capture _jq_out jq '.ssh_string' <<< "${_ssh}"
		capture _ssh_string strstrip --str="${_jq_out}" --chars='"'
		capture _ssh_pref substr --pos=0 --len=3 --str="${_ssh_string}"
		if [ "${_ssh_pref}" != "ssh" ]; then
			${ECHO} "${N1_COLOR}${CIX_APP} error: curl error2, no ssh_string:\n${N2_COLOR}${_ssh}${N0_COLOR}"
			${ECHO} "${CURL_CMD} --no-progress-meter -H \"cid:XXXXX\" ${CLOUD_URL}/api/v1/status/${jname}"
			_global_ret=$(( _global_ret + 1 ))
			continue
		fi
		capture _ssh_len strlen "${_ssh_string}"
		capture _ssh_post substr --pos=5 --len=${_ssh_len} --str="${_ssh_string}"
		# rewrite
		if [ -n "${SUDO_USER}" ]; then
			if [ -r /home/${SUDO_USER}/.ssh/id_ed25519 ]; then
				_ssh_sudo_arg="-oIdentityFile=/home/${SUDO_USER}/.ssh/id_ed25519"
			elif [ -r /home/${SUDO_USER}/.ssh/id_rsa ]; then
				_ssh_sudo_arg="-oIdentityFile=/home/${SUDO_USER}/.ssh/id_rsa"
			fi
		fi
		jexec_cmd="${SSH_CMD} -T -oStrictHostKeyChecking=no -oBatchMode=yes -oConnectTimeout=5 -oServerAliveInterval=10 ${_ssh_sudo_arg} ${_ssh_post}"

		jexec_defaults
		if [ "${_jexec_argc}" -gt 0 ]; then
			set -- "${CIX_JSON_ARGS@.argv[]}"
		else
			set --
		fi
		if [ -z "${cmd}" ] && [ $# -eq 0 ]; then
			case "${shell}" in
				no|auto) set -- /bin/sh ;;
				*) set -- "${shell}" ;;
			esac
		elif [ "${shell}" != "no" ] && [ "${shell}" != "auto" ]; then
			if [ -n "${cmd}" ]; then
				set -- "${shell}" -c "${cmd}" "${shell}" "$@"
			else
				_shcmd=$1
				shift
				set -- "${shell}" -c "${_shcmd}" "${shell}" "$@"
			fi
		elif [ "${shell}" = "auto" ] && [ -n "${cmd}" ]; then
			case "${cmd}" in
				*["${_jexec_meta}"]*) set -- /bin/sh -c "${cmd}" /bin/sh "$@" ;;
				*) set -- "${cmd}" "$@" ;;
			esac
		elif [ "${shell}" = "auto" ] && [ $# -gt 0 ]; then
			case "$1" in
				*["${_jexec_meta}"]*)
					_shcmd=$1
					shift
					set -- /bin/sh -c "${_shcmd}" /bin/sh "$@"
					;;
			esac
		elif [ $# -eq 0 ]; then
			set -- "${cmd}"
		fi
		# Directory is jexec_env -d. -s no: the command above is already final.
		# env keeps environment= after jexec_env clears its own environment.
		# shellcheck disable=2086
		${jexec_cmd} "${miscdir}/jexec_env" -d "${dir}" -s no "${jname}" -- \
			env "${CIX_JSON_ARGS@.kw.environment[]?}" -- "$@"
		_ret=$?
		[ ${_ret} -ne 0 ] && _global_ret=$(( _global_ret + 1 ))
	done
	exit ${_global_ret}
else
	. ${subrdir}/rcconf.subr
	[ $? -eq 1 ] && err 1 "${N1_COLOR}no such jail: ${N2_COLOR}${jname}${N0_COLOR}"
	[ "${emulator}" = "bhyve" ] && err 1 "${N1_COLOR}Not for bhyve mode${N0_COLOR}"

	[ ${jid} -eq 0 ] && err 1 "Not running"
	#rctl/limits area
	. ${subrdir}/rctl.subr
	[ -z "${nice}" ] && nice="0"
	_formfile="${jailsysdir}/${jname}/helpers/jrctl.sqlite"
	[ -r "${_formfile}" ] && capture nice cbsdsqlro ${_formfile} "SELECT cur FROM forms WHERE param='nice'"
	[ -z "${nice}" ] && nice="0"

	if [ ${exec_fib} -eq 0 ]; then
		SETFIB=""
	else
		SETFIB="${SETFIB_CMD} ${exec_fib}"
	fi

	if [ "${cpuset}" = "0" ]; then
		CPUSET=""
	else
		CPUSET="${CPUSET_CMD} -c -l ${cpuset}"
	fi

	[ ${baserw} -eq 1 ] && path="${data}"

	# is linux?
	if [ -f "${path}/bin/bash" ]; then
		capture OSNAME ${miscdir}/elf_tables --osname ${path}/bin/bash
		LOGIN_STR="/bin/bash"
	elif [ -f "${path}/bin/sh" ]; then
		capture OSNAME ${miscdir}/elf_tables --osname ${path}/bin/sh
		LOGIN_STR="/bin/sh"
	elif [ -f ${path}/bin/busybox ]; then
		capture OSNAME ${miscdir}/elf_tables --osname ${path}/bin/busybox
		LOGIN_STR="/bin/sh"
	else
		err 1 "${N1_COLOR}Unknown environment, unable to jexec: ${path}${N0_COLOR}"
	fi

	case "${OSNAME}" in
		freebsd)
			[ -n "${ouser}" ] && user="${ouser}"
			[ -z "${user}" ] && user="root"
			if [ "${emulator}" != "jail" -a -n "${emulator}" ]; then
				. ${subrdir}/emulator.subr
				init_usermode_emul
				# inherit emulator_flags
				LOGIN_STR="/bin/${emulator} ${LOGIN_CMD} -f ${user}"
			else
				LOGIN_STR=""
			fi
			;;
		*)
			LOGIN_STR=""
			;;
	esac

	jexec_defaults
	_first=
	if [ "${_jexec_argc}" -gt 0 ]; then
		_first="${CIX_JSON_ARGS@.argv[0]}"
	elif [ -n "${cmd}" ]; then
		_first=${cmd%% *}
	fi

	if [ -n "${_first}" ] && [ -x "${jailsysdir}/${jname}/cmd/${_first}" ]; then
		. ${subrdir}/jcreate.subr		# for export_jail_data_for_external_hook
		export_jail_data_for_external_hook
		if [ "${_jexec_argc}" -gt 0 ]; then
			exec "${jailsysdir}/${jname}/cmd/${_first}" "${CIX_JSON_ARGS@.argv[1:][]}"
		else
			exec "${jailsysdir}/${jname}/cmd/${_first}"
		fi
	fi

	# Flags, then the jail, then the command.
	# cmd is the script. -s no executes the arguments as given.
	jexec_run()
	{
		_jexec_envfile=
		_ret=0

		for _v in "${CIX_JSON_ARGS@.kw.environment[]?}"; do
			[ -z "${_v}" ] && continue
			if [ -z "${_jexec_envfile}" ]; then
				capture _jexec_envfile ${MKTEMP_CMD}
			fi
			if [ -f "${_v}" ]; then
				cat "${_v}" >> "${_jexec_envfile}"
				printf '\n' >> "${_jexec_envfile}"
			else
				printf '%s\n' "${_v}" >> "${_jexec_envfile}"
			fi
		done

		if [ -n "${LOGIN_STR}" ]; then
			# qemu user-mode: LOGIN_STR is the program, not a -c string.
			if [ $# -eq 0 ]; then
				${NICE_CMD} -n ${nice} ${SETFIB} ${CPUSET} ${JEXEC_CMD} ${jid} ${LOGIN_STR}
			else
				${NICE_CMD} -n ${nice} ${SETFIB} ${CPUSET} ${JEXEC_CMD} ${jid} ${LOGIN_STR} "$@"
			fi
			_ret=$?
		elif [ "${platform}" = "DragonFly" ]; then
			if [ $# -eq 0 ]; then
				case "${shell}" in
					no|auto) ${NICE_CMD} -n ${nice} ${JEXEC_CMD} ${jid} /bin/sh ;;
					*) ${NICE_CMD} -n ${nice} ${JEXEC_CMD} ${jid} "${shell}" ;;
				esac
			elif [ "${_jexec_s}" != "no" ] && [ "${_jexec_s}" != "auto" ]; then
				_shcmd=$1
				shift
				${NICE_CMD} -n ${nice} ${JEXEC_CMD} ${jid} "${_jexec_s}" -c "${_shcmd}" "${_jexec_s}" "$@"
			elif [ "${_jexec_s}" = "auto" ]; then
				case "$1" in
					*["${_jexec_meta}"]*)
						_shcmd=$1
						shift
						${NICE_CMD} -n ${nice} ${JEXEC_CMD} ${jid} /bin/sh -c "${_shcmd}" /bin/sh "$@"
						;;
					*)
						${NICE_CMD} -n ${nice} ${JEXEC_CMD} ${jid} "$@"
						;;
				esac
			else
				${NICE_CMD} -n ${nice} ${JEXEC_CMD} ${jid} "$@"
			fi
			_ret=$?
		else
			_uarg=
			[ "${user}" != "root" ] && [ "${ver}" != "empty" ] && _uarg="-U ${user}"
			if [ -n "${_jexec_envfile}" ]; then
				${NICE_CMD} -n ${nice} ${SETFIB} ${CPUSET} ${miscdir}/jexec_env \
					${_uarg} -d "${dir}" -e "${_jexec_envfile}" -s "${_jexec_s}" \
					"${jname}" -- "$@"
			else
				${NICE_CMD} -n ${nice} ${SETFIB} ${CPUSET} ${miscdir}/jexec_env \
					${_uarg} -d "${dir}" -s "${_jexec_s}" \
					"${jname}" -- "$@"
			fi
			_ret=$?
		fi
		[ -n "${_jexec_envfile}" ] && ${RM_CMD} -f "${_jexec_envfile}"
		return ${_ret}
	}

	# cmd= is the script when set. Otherwise the first argument is.
	# An explicit shell always runs -c. auto does that only if the script has metacharacters.
	_jexec_s="${shell}"
	if [ -n "${cmd}" ] && [ "${shell}" != "no" ]; then
		if [ "${_jexec_argc}" -gt 0 ]; then
			jexec_run "${cmd}" "${CIX_JSON_ARGS@.argv[]}"
		else
			jexec_run "${cmd}"
		fi
	elif [ "${_jexec_argc}" -gt 0 ]; then
		jexec_run "${CIX_JSON_ARGS@.argv[]}"
	elif [ -n "${cmd}" ]; then
		jexec_run "${cmd}"
	else
		jexec_run
	fi
	ret=$?
fi

exit ${ret}
