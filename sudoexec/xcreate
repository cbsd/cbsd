			IFS=","
		done
		IFS="${OIFS}"

		ip4_addr="${_ip4_addr}"
		ci_ip4_addr="${normalize_ci_ip4_addr}"

		${CIX_DISTDIR}/misc/cbsdsysrc -qf ${jailsysdir}/${jname}/rc.conf_${jname} ip4_addr="${ip4_addr}" ci_ip4_addr="${normalize_ci_ip4_addr}" > /dev/null 2>&1
		bset jname="${jname}" ip4_addr="${_ip4_addr}" ci_ip4_addr="${normalize_ci_ip4_addr}" > /dev/null 2>&1
	fi

	[ -n "${ci_gw42}" ] && ${CIX_DISTDIR}/misc/cbsdsysrc -qf ${jailsysdir}/${jname}/rc.conf_${jname} ci_gw42="${ci_gw42}" > /dev/null 2>&1

	if [ -n "${ci_ip4_addr2}" ]; then
		#todo: normalize

		_ip4_addr=
		# strip mask for ip4_addr
		OIFS="${IFS}"
		IFS=","
		for _pureip in ${ci_ip4_addr2}; do
			IFS="${OIFS}"
