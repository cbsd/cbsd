#!/usr/bin/env cbsd
CIXARG=""
CIXOPTARG="jname"
MYDESC="Show the jail console"
CBSDMODULE="jail"
ADDHELP="
${H3_COLOR}Description${N0_COLOR}:

 Show the jail console buffer. The jail name is the first argument,
 or ${N2_COLOR}jname=<jail>${N0_COLOR}.
 Flags after it are the same as ${N2_COLOR}cbsdlogctl console${N0_COLOR}.
 ${N2_COLOR}-C${N0_COLOR}/${N2_COLOR}--color auto${N0_COLOR} is the default.

${H3_COLOR}Options${N0_COLOR}:

 ${N2_COLOR}jname=${N0_COLOR}                   jail name, instead of the first argument
 ${N2_COLOR}-f${N0_COLOR}, ${N2_COLOR}--follow${N0_COLOR}             read until the console closes
 ${N2_COLOR}-t${N0_COLOR}, ${N2_COLOR}--timeout${N0_COLOR} seconds    stop the read after this many seconds
 ${N2_COLOR}-W${N0_COLOR}, ${N2_COLOR}--wait${N0_COLOR} seconds       wait this long for the console to open
 ${N2_COLOR}-C${N0_COLOR}, ${N2_COLOR}--color${N0_COLOR} auto|yes|no  color stdout and stderr

${H3_COLOR}Examples${N0_COLOR}:

 # cbsd console myjail
 # cbsd console jname=myjail
 # cbsd console myjail --follow
 # cbsd console myjail -f -t 2
 # cbsd console myjail -W 5 --follow

"
unset jname
. ${subrdir}/nc.subr
cixinit

usage()
{
	err 1 "${N1_COLOR}usage: ${N2_COLOR}cbsd console <jail> [-f|--follow] [-t|--timeout seconds] [-W|--wait seconds] [-C|--color auto|yes|no]${N0_COLOR}"
}

# jname= is already in $jname. What remains is the positional name and the flags.
set -f
set -- ${CIX_OTHER_ARGS}
set +f
if [ -z "${jname}" ]; then
	[ $# -ge 1 ] || usage
	jname=$1
	shift
fi
[ -n "${jname}" ] || usage
case "${jname}" in
	-*)
		usage
		;;
esac
case "${jname}" in
	.|..|*[!A-Za-z0-9._-]*)
		err 1 "${N1_COLOR}bad jail name: ${N2_COLOR}${jname}${N0_COLOR}"
		;;
esac

[ -x "${miscdir}/cbsdlogctl" ] || err 1 "${N1_COLOR}cbsdlogctl is not installed: ${N2_COLOR}${miscdir}/cbsdlogctl${N0_COLOR}"

exec "${miscdir}/cbsdlogctl" console "$@" "${jname}"
