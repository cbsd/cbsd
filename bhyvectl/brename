#!/usr/bin/env cbsd
#v12.1.0
CIXARG="old new"
CIXOPTARG="host_hostname restart"
MYDESC="Rename bhyve domain"
CBSDMODULE="bhyve"
ADDHELP="
${H3_COLOR}Description${N0_COLOR}:

 Rename a bhyve domain from old name to new name.
 Updates all references in jails, bhyve, rctl, storage and ZFS datasets.

${H3_COLOR}Options${N0_COLOR}:

 ${N2_COLOR}old=${N0_COLOR}             - current bhyve domain name;
 ${N2_COLOR}new=${N0_COLOR}             - new bhyve domain name;
 ${N2_COLOR}host_hostname=${N0_COLOR}  - new hostname (optional);
 ${N2_COLOR}restart=${N0_COLOR}        - set to 1 to auto-stop/start VM during rename (default: 0);

${H3_COLOR}Examples${N0_COLOR}:

 # cbsd brename old=vm1 new=vm2
 # cbsd brename old=vm1 new=vm2 restart=1

${H3_COLOR}See also${N0_COLOR}:

  cbsd bset --help
  cbsd bconfig --help
  cbsd bstart --help

"
EXTHELP="wf_jrename"

. ${subrdir}/nc.subr
. ${tools}
. ${jfs}
. ${strings}

restart=0
cixinit

[ -z "${old}" ] && err 1 "${N1_COLOR}mandatory parameter: ${N2_COLOR}old=${N0_COLOR}"
[ -z "${new}" ] && err 1 "${N1_COLOR}mandatory parameter: ${N2_COLOR}new=${N0_COLOR}"

if [ "${mod_cbsd_queue_enabled}" = "YES" -a -z "${MOD_CBSD_QUEUE_DISABLED}" ]; then
	readconf cbsd_queue.conf
	[ -z "${cbsd_queue_backend}" ] && MOD_CBSD_QUEUE_DISABLED="1"
fi

DST="${jaildatadir}/${new}-${jaildatapref}"
SRC="${jaildatadir}/${old}-${jaildatapref}"
JAILDIR="${jaildir}/${new}"
JAILFSTAB="${jailfstabdir}/${jailfstabpref}${new}"
JAILFSTABORIG="${jailfstabdir}/${jailfstabpref}${old}"
JAILLOCALFSTAB="${jailfstabdir}/${jailfstabpref}${new}.local"
JAILLOCALFSTABORIG="${jailfstabdir}/${jailfstabpref}${old}.local"
SYSDIROLD="${jailsysdir}/${old}"
SYSDIRNEW="${jailsysdir}/${new}"

# store new params in tmp variable
host_hostname_new="${host_hostname}"
ip4_addr_new="${ip4_addr}"

jname="${old}"
. ${subrdir}/rcconf.subr

[ -z "${host_hostname_new}" ] && host_hostname_new="${host_hostname}"
[ -z "${ip4_addr_new}" ] && ip4_addr_new="${ip4_addr}"
[ "${emulator}" != "bhyve" ] && err 1 "${N1_COLOR}Not bhyve mode${N0_COLOR}"

. ${subrdir}/time.subr
gettime st_time


capture myjid cbsdsqlro local "SELECT jname FROM jails WHERE jname='${new}'"
[ -n "${myjid}" ] && err 1 "${N1_COLOR}Jail already exist: ${N2_COLOR}${new}${N0_COLOR}"

if [ "${mod_cbsd_queue_enabled}" = "YES" -a -z "${MOD_CBSD_QUEUE_DISABLED}" ]; then
	[ -n "${cbsd_jail_queue_name}" ] && ${cbsd_queue_backend} cbsd_queue_name=${cbsd_bhyve_queue_name} id="${old}" jname="${new}" cmd=brename status=1
fi

oldjid=${status}

case ${status} in
	0)
		true
		;;
	*)
		if [ ${restart} -eq 1 ]; then
			cbsdlogger NOTICE ${CIX_APP}: vm ${jname} will be stopped due to restart flags on
			bstop jname=${old}
		else
			if [ "${mod_cbsd_queue_enabled}" = "YES" -a -z "${MOD_CBSD_QUEUE_DISABLED}" ]; then
				[ -n "${cbsd_jail_queue_name}" ] && ${cbsd_queue_backend} cbsd_queue_name=${cbsd_bhyve_queue_name} id="${new}" jname="${new}" cmd=brename status=2
			fi
			log_err 1 "${N1_COLOR}VM is online. Please stop them: ${N2_COLOR}${old}${N1_COLOR} or add ${N2_COLOR}restart=1${N1_COLOR} to auto stop and start VM during rename${N0_COLOR}"
		fi
		;;
esac

[ ! -d "${SRC}" ] && log_err 1 "${N1_COLOR}No VM data: ${N2_COLOR}${SRC}${N0_COLOR}"

if [ -d "${DST}" ]; then
	${RMDIR_CMD} ${DST} >/dev/null 2>&1
	[ -d "${DST}" ] && log_err 1 "${N1_COLOR}VM data already exist and it not empty: ${N2_COLOR}${DST}${N0_COLOR}"
fi

[ ! -d "${JAILDIR}" ] && ${MKDIR_CMD} -p ${JAILDIR}
[ ! -d "${jailfstab}"  ] && ${MKDIR_CMD} -p ${jailfstabdir}

printf "${N1_COLOR}Rename${N0_COLOR}"

if [ -f "${JAILFSTABORIG}" ]; then
	${MV_CMD} ${JAILFSTABORIG} ${JAILFSTAB}
	${SED_CMD} -i${SED_DELIMER}'' s:/${old}:/${new}:g ${JAILFSTAB}
fi

[ -f "${JAILLOCALFSTABORIG}" ] && ${MV_CMD} ${JAILLOCALFSTABORIG} ${JAILLOCALFSTAB} && dot "mv fstablocal"

cbsdsqlrw local "UPDATE jails SET jname='${new}',path='${jaildir}/${new}',mount_fstab='${jailfstabdir}/${jailfstabpref}${new}',data='${jaildatadir}/${new}-${jaildatapref}',rcconf='${jailsysdir}/${jname}/rc.conf_${new}' WHERE jname='${old}'"
cbsdsqlrw local "UPDATE rctl SET jname='${new}' WHERE jname='${old}'" 2>/dev/null
cbsdsqlrw local "UPDATE bhyve SET jname='${new}' WHERE jname='${old}'" 2>/dev/null
cbsdsqlrw ${jailsysdir}/${jname}/local.sqlite "UPDATE bhyvedsk SET jname='${new}' WHERE jname='${old}'" 2>/dev/null
cbsdsqlrw ${jailsysdir}/${jname}/local.sqlite "UPDATE bhyvenic SET jname='${new}' WHERE jname='${old}'" 2>/dev/null

# rename rc.conf values if exist
if [ -r ${jailsysdir}/${jname}/rc.conf_${old} ]; then
	is_cloud=0
	capture is_cloud ${AWK_CMD} -F'"' '/^is_cloud=/{print $2}' ${jailsysdir}/${jname}/rc.conf_${old} 2>/dev/null
	[ -z "${is_cloud}" ] && is_cloud=0
	updateconf ${jailsysdir}/${jname}/rc.conf_${old} path="${jaildir}/${new}" jname="${new}" rcconf="${jailsysdir}/${new}/rc.conf_${new}" data="${jaildatadir}/${new}-${jaildatapref}"

	if [ ${is_cloud} -eq 0 ]; then
		updateconf ${jailsysdir}/${jname}/rc.conf_${old} ci_jname="${new}"
	fi
	${MV_CMD} ${jailsysdir}/${jname}/rc.conf_${old} ${jailsysdir}/${jname}/rc.conf_${new}
fi

#
# rename ppt
if [ "${new}" = "ppt" ]; then
	# sqlite3 use name of column to insert data?? when new="ppt", we got 'ppt' value from column as jname, bug?
	cbsdsqlrw local "UPDATE bhyveppt SET jname='ppt' WHERE jname='${old}'"
else
	cbsdsqlrw local "UPDATE bhyveppt SET jname='${new}' WHERE jname='${old}'"
fi

if [ -n "${ip4_addr_new}" ]; then
	cbsdsqlrw local "UPDATE jails SET ip4_addr='${ip4_addr_new}' WHERE jname='${new}'"
fi

if [ -n "${host_hostname_new}" ]; then
	cbsdsqlrw local "UPDATE jails SET host_hostname='${host_hostname_new}' WHERE jname='${new}'"
fi

jname=${new}

# Update in media table: vhd and ISO
# Update records only for vhd + (/jails-data/|/vm/) location, don't touch/manage disks outside jails-data/vm dir or /dev/RAW devices
capture _dsk_list ${FIND_CMD} ${SRC}/ -mindepth 1 -maxdepth 1 -name 'dsk*' -type l -or -type f

for i in ${_dsk_list}; do
	[ -z "${i}" ] && continue

	# basename
	dskname="${i##*/}"
	capture idx cbsdsqlro storage_media "SELECT idx FROM media WHERE path='${workdir}/jails-data/${old}-data/${dskname}' OR path='${workdir}/vm/${old}/${dskname}' AND jname='${old}'"
	[ -z "${idx}" ] && continue

	cbsdsqlro_vars storage_media "SELECT path FROM media WHERE idx='${idx}'" _old_path
	capture _new_path ${SED_CMD} -e "s:${old}-data:${new}-data:g" -e "s:vm/${old}/:vm/${new}/:g" <<< "${_old_path}"
	cbsdlogger NOTICE ${CIX_APP}: update storage: path:${_new_path},jname=${new} for idx:${idx}
	cbsdsqlrw storage_media "UPDATE media SET path='${_new_path}',jname='${new}' WHERE idx=${idx}"
done

# update ISO
cbsdsqlrw storage_media "UPDATE media SET jname='${new}' WHERE jname='${old}' AND type='iso'"

case ${zfsfeat} in
	1)
		. ${subrdir}/zfs.subr
		[ ! -d ${workdir}/vm ] && ${MKDIR_CMD} -p ${workdir}/vm
		capture DATA ${ZFS_CMD} get -Ho value name ${jaildatadir}
		capture _old_mpt ${ZFS_CMD} get -Ho value mountpoint ${DATA}/${old}
		_ret=$?
		if [ ${_ret} -eq 0 -a -n "${_old_mpt}" ]; then
			# loop to check for symlink and zvol
			capture _symlinks ${FIND_CMD} ${SRC}/ -mindepth 1 -maxdepth 1 -type l
			for i in ${_symlinks}; do
				if is_getzvol ${i}; then
					# back compatible for CBSD <= 12.1.0
					capture _new_zvol_dsk_name ${SED_CMD} "s:bcbsd-${old}-dsk:bcbsd-${new}-dsk:g" <<< "${is_zvol}"
					# replace "jails/OLDVM/dskX.vhd" path
					capture _new_zvol_dsk_name ${SED_CMD} "s:/${old}/:/${new}/:g" <<< "${_new_zvol_dsk_name}"
					if [ -n "${_new_zvol_dsk_name}" -a "${_new_zvol_dsk_name}" != "${is_zvol}" ]; then
						case "${is_zvol}" in
							*bcbsd-*)
								# back compatible for CBSD <= 12.1.0
								# rename from bcbsd- to new form
								cbsdlogger NOTICE ${CIX_APP}: zfs rename ${is_zvol} ${_new_zvol_dsk_name}
								${ZFS_CMD} rename ${is_zvol} ${_new_zvol_dsk_name} > /dev/null 2>&1
								_ret=$?
								if [ ${_ret} -ne 0 ]; then
									${ECHO} "${LRED}Error: ${MAGENTA}${ZFS_CMD} rename ${is_zvol} ${_new_zvol_dsk_name} failed${NORMAL}"
									cbsdlogger NOTICE ${CIX_APP}: zfs rename ${is_zvol} ${_new_zvol_dsk_name} failed
								fi
								;;
						esac
						# re-link
						${LN_CMD} -sf /dev/zvol/${_new_zvol_dsk_name} ${i}
					fi
				fi
			done

			cbsdlogger NOTICE ${CIX_APP}: ${ZFS_CMD} unmount -f ${_old_mpt}
			${ZFS_CMD} unmount -f ${_old_mpt} > /dev/null 2>&1
			cbsdlogger NOTICE ${CIX_APP}: ${ZFS_CMD} rename ${DATA}/${old} ${DATA}/${new}
			${ZFS_CMD} rename ${DATA}/${old} ${DATA}/${new}
			cbsdlogger NOTICE ${CIX_APP}: ${ZFS_CMD} set mountpoint=${workdir}/vm/${new} ${DATA}/${new}
			${ZFS_CMD} set mountpoint=${workdir}/vm/${new} ${DATA}/${new}
			${ZFS_CMD} mount ${DATA}/${new}
		fi
		if [ -h ${SRC} ]; then
			${RM_CMD} ${SRC}
			${LN_CMD} -sf ${workdir}/vm/${new} ${DST}
		else
			# todo: mixed content? symlink + md?
			mvdata ${SRC} ${DST}
			dot "mvdata"
		fi
		;;
	*)
		mvdata ${SRC} ${DST}
		dot "mvdata"
		;;
esac

case ${zfsfeat} in
	1)
		if [ -h "${SYSDIROLD}" ]; then
			${RM_CMD} -f ${SYSDIROLD}
			${LN_CMD} -sf ${workdir}/vm/${new} ${SYSDIRNEW}
		elif [ -d "${SYSDIROLD}" ]; then
			${MV_CMD} ${SYSDIROLD} ${SYSDIRNEW}
		fi
		;;
	*)
		if [ -d "${SYSDIROLD}" ]; then
			${MV_CMD} ${SYSDIROLD} ${SYSDIRNEW}
		fi
esac

if [ -r ${jailsysdir}/${jname}/local.sqlite ]; then
	cbsdsqlrw ${jailsysdir}/${jname}/local.sqlite "UPDATE bhyvedsk set jname='${new}'"
	cbsdsqlrw ${jailsysdir}/${jname}/local.sqlite "UPDATE bhyvenic set jname='${new}'"
fi

if [ ${restart} -eq 1 -a ${oldjid} -ne 0 ]; then
	cbsdlogger NOTICE ${CIX_APP}: vm ${jname} will be started due to restart flags on
	bstart jname=${new}
	data_status=1
else
	data_status=0
fi

if [ "${mod_cbsd_queue_enabled}" = "YES" -a -z "${MOD_CBSD_QUEUE_DISABLED}" ]; then
	[ -n "${cbsd_jail_queue_name}" ] && ${cbsd_queue_backend} cbsd_queue_name=${cbsd_bhyve_queue_name} id="${new}" cmd=brename status=2 data_status=${data_status}
fi

[ -d "${SRC}" ] && ${RMDIR_CMD} ${SRC}

gettime end_time
diff_time=$(( end_time - st_time ))
capture diff_time displaytime ${diff_time}
${ECHO} " ${N2_COLOR}ok${N0_COLOR}"

${ECHO} "${N1_COLOR}${CIX_APP} done ${N2_COLOR}in ${diff_time}${N0_COLOR}"
cbsdlogger NOTICE ${CIX_APP}: vm ${old} has been renamed to ${new} in ${diff_time}

exit 0
