#!/usr/bin/env cbsd
#v10.1.2
CIXARG=""
CIXOPTARG="jname"
CBSDMODULE="bhyve"
MYDESC="Ncurses based bhyve order editor"
EXTHELP="wf_jorder"
ADDHELP="
${H3_COLOR}Description${N0_COLOR}:

 Interactive boot order editor for bhyve domains.
 Allows changing the boot priority of bhyve VMs.
 Lower weight means higher priority (first to boot).

${H3_COLOR}Options${N0_COLOR}:

 ${N2_COLOR}jname=${N0_COLOR} - pre-select bhyve domain in the list;

${H3_COLOR}Examples${N0_COLOR}:

 # cbsd border-tui
 # cbsd border-tui jname=myvm

${H3_COLOR}See also${N0_COLOR}:

  cbsd border --help
  cbsd bconfig --help
  cbsd bsetup-tui --help

"

. ${subrdir}/nc.subr
. ${tools}

cixinit

. ${strings}
. ${subrdir}/settings-tui.subr
. ${subrdir}/settings-tui-virtual.subr
. ${subrdir}/settings-tui-bhyve.subr
. ${dialog}

load_table()
{
	local _q= _rows=

	capture _rows cbsdsqlquery local "SELECT jname,b_order FROM jails WHERE status<2 AND emulator='bhyve' ORDER BY CAST(b_order AS int) ASC"
	_jnum=0
	while read _q; do
		[ -z "${_q}" ] && continue
		# shellcheck disable=SC2034
		eval export jails_${_jnum}_jname=\"\${_q@.jname}\"
		eval export jails_${_jnum}_order=\"\${_q@.b_order}\"
		_jnum=$(( _jnum + 1 ))
	done <<< "${_rows}"
}


# $1 - jname
# $2 - new order
update_order()
{
	[ -z "${1}" ] && return 1
	[ -z "${2}" ] && return 1

	local jname="${1}"
	local order="${2}"

	cbsdsqlrw local "UPDATE jails SET b_order='${order}' WHERE jname='${jname}' AND emulator='bhyve'"
}


# $1 - jname
# $2 - index
get_new_value()
{
	local _input
	[ -z "${1}" ] && return 1
	local jname="${1}"

	f_dialog_title " order "

	f_dialog_input _input "Enter weight. Lower weight = higher priority, first boot: 0" "${index}" \
		"${_message}" || return $?

	update_order ${jname} ${_input}
}


dialog_menu_main()
{
	local title=" ${product} v${myversion} "
	local btitle="$DIALOG_BACKTITLE"
	local prompt="Use menu to select bhyve domain"
	local defaultitem=
	local hline=
	local _i _jnum _order _jname=

	load_table

	local menu_list=" \
		'EXIT'		'EXIT'		'Exit boot order editor' \
		'-'		'-'		'' \
	"

	_jnum=0
	eval _jname="\$jails_${_jnum}_jname"
	eval _order="\$jails_${_jnum}_order"

	while [ -n "${_jname}" ]; do
		eval _order="\$jails_${_jnum}_order"
		menu_list="${menu_list} '${_order} ${_jname}' '${_order} ${_jname}' 'Boot order ${_order}: ${_jname}'"

		if [ "${selected}" = "${_jname}" ]; then
			defaultitem="${_order} ${_jname}"
			f_dialog_default_store "${defaultitem}"
		fi

		_jnum=$(( _jnum + 1 ))
		unset _jname _order
		eval _jname="\$jails_${_jnum}_jname"
		eval _order="\$jails_${_jnum}_order"
	done

	f_dialog_default_fetch defaultitem

	local menu_choice
	cbsd_menubox_with_help
	local retval=$?

	f_dialog_data_sanitize menu_choice
	f_dialog_menutag_store "$menu_choice"
	f_dialog_default_store "$menu_choice"

	if [ ${retval} -eq ${DIALOG_OK} ]; then
		selected=${menu_choice##* }
	fi

	return $retval
}


#### [ MAIN AREA ] ####
[ ! -f ${localcbsdconf} ] && err 1 "${N1_COLOR}no such conf file${N0_COLOR}"
. ${localcbsdconf}
. ${inventory}

f_dialog_title "$msg_system_console_configuration"
f_dialog_backtitle "${ipgm:+bsdconfig }$pgm"

[ -n "${jname}" ] && selected="${jname}"

while [ 1 ]; do
	dialog_menu_main || f_die

	f_dialog_menutag_fetch mtag

	index=${mtag%% *}
	mychoice=${mtag##* }

	case "${mychoice}" in
		"EXIT")
			exit 0
			;;
		"-")
			continue
			;;
		*)
			get_new_value ${mychoice} ${index}
			;;
	esac
done

exit 0
