#!/usr/bin/env cbsd
#v12.0.4
CIXARG=""
CIXOPTARG="address alljails display driver flags header hwaddr id interface jname mode mtu node order persistent ratelimit shownode slot tagged type untagged vlan_tagged vlan_untagged"
MYDESC="Manage bhyve virtual NICs"
CBSDMODULE="bhyve"
EXTHELP="wf_bhyve"
ADDHELP="
${H3_COLOR}Description${N0_COLOR}:

 List, add, update and delete bhyve virtual network interfaces.

${H3_COLOR}Usage${N0_COLOR}:

 cbsd bhyve-nic [mode=list] [jname=<vm>]
 cbsd bhyve-nic mode=add jname=<vm> [interface=auto] ...
 cbsd bhyve-nic mode=update jname=<vm> id=<id> [interface=...] ...
 cbsd bhyve-nic mode=delete jname=<vm> id=<id>

${H3_COLOR}Options${N0_COLOR}:

 ${N2_COLOR}alljails=${N0_COLOR}  - include remote nodes in the output. Default: local only.
 ${N2_COLOR}shownode=${N0_COLOR}  - display node name in the output.
 ${N2_COLOR}display=${N0_COLOR}   - comma-separated list of columns to show.
             Default: id,jname,nic_driver,nic_parent,nic_hwaddr,nic_address,nic_mtu,nic_vlan_untagged,nic_vlan_tagged.
 ${N2_COLOR}node=${N0_COLOR}      - query specific node(s) only.
 ${N2_COLOR}header=${N0_COLOR}    - set to 0 to suppress the header line. Default: 1.
 ${N2_COLOR}jname=${N0_COLOR}     - target virtual machine name.
 ${N2_COLOR}mode=${N0_COLOR}      - list, add, update or delete. Default: list.
 ${N2_COLOR}id=${N0_COLOR}        - NIC database ID, required by update and delete.
 ${N2_COLOR}driver=${N0_COLOR}    - bhyve NIC driver: vtnet or e1000.
 ${N2_COLOR}interface=${N0_COLOR} - parent interface or bridge. Default: auto.
 ${N2_COLOR}hwaddr=${N0_COLOR}    - MAC address. Default: 0 (auto-generate).
 ${N2_COLOR}address=${N0_COLOR}   - IP address on the host side. Default: 0.
 ${N2_COLOR}mtu=${N0_COLOR}       - MTU. Default: 0 (inherit from parent).
 ${N2_COLOR}persistent=${N0_COLOR} - persistent tap interface flag: 0 or 1.
 ${N2_COLOR}ratelimit=${N0_COLOR} - NIC bandwidth limit. Default: 0.
 ${N2_COLOR}flags=${N0_COLOR}     - comma-separated bridge flags, e.g. private.
 ${N2_COLOR}vlan_untagged=${N0_COLOR} - untagged VLAN ID. Default: 0.
 ${N2_COLOR}vlan_tagged=${N0_COLOR}   - tagged VLAN set, comma-separated. Default: 0.

${H3_COLOR}Examples${N0_COLOR}:

 # cbsd bhyve-nic
 # cbsd bhyve-nic jname=myvm
 # cbsd bhyve-nic display=jname,nic_hwaddr,nic_parent header=0
 # cbsd bhyve-nic add myvm interface=bridge0 vlan_untagged=100
 # cbsd bhyve-nic update myvm 1 vlan_tagged=200,300
 # cbsd bhyve-nic delete myvm 2

${H3_COLOR}See also${N0_COLOR}:

  cbsd bhyve-nic-list --help
  cbsd bconfig --help
  cbsd bset --help

"

. ${subrdir}/nc.subr
. ${system}

cixinit
. ${subrdir}/bhyve.subr
. ${subrdir}/virtual.subr

normalize_argv()
{
	local _arg _args= _space=

	for _arg in ${CIX_OTHER_ARGS}; do
		case "${_arg}" in
			*=*) ;;
			*)
				_args="${_args}${_space}${_arg}"
				_space=" "
				;;
		esac
	done

	${ECHO} "${_args}"
}

# Accept both "bhyve-nic add vm [id]" and "bhyve-nic vm add [id]".
set -- $( normalize_argv )
case "${1}" in
	list|add|update|delete|del)
		[ -z "${mode}" ] && mode="${1}"
		shift
		[ -z "${jname}" -a -n "${1}" ] && jname="${1}" && shift
		;;
	*)
		[ -z "${jname}" -a -n "${1}" ] && jname="${1}" && shift
		[ -z "${mode}" -a -n "${1}" ] && mode="${1}" && shift
		;;
esac
[ -z "${id}" -a -n "${1}" ] && id="${1}" && shift
[ -n "${1}" ] && err 1 "${N1_COLOR}bhyve-nic: too many arguments: ${N2_COLOR}${1}${N0_COLOR}"

case "${mode}" in
	""|list) mode="list" ;;
	del) mode="delete" ;;
esac

[ -z "${vlan_tagged}" -a -n "${tagged}" ] && vlan_tagged="${tagged}"
[ -z "${vlan_untagged}" -a -n "${untagged}" ] && vlan_untagged="${untagged}"

[ -z "${display}" ] && display="id,jname,nic_driver,nic_parent,nic_hwaddr,nic_address,nic_mtu,nic_vlan_untagged,nic_vlan_tagged"

mydisplay=$( printf '%s' "${display}" | ${TR_CMD} ',' ' ' )
myheader=$( printf '%s' "${mydisplay}" | ${TR_CMD} '[:lower:]' '[:upper:]' )

show_header()
{
	local _header="${H1_COLOR}${BOLD}${myheader}${N0_COLOR}"
	[ ${header} -ne 0 ] && ${ECHO} "${_header}"
}

populate_output_data()
{
	local _i _val

	for _i in ${mydisplay}; do
		_val=
		eval _val=\$$_i
		[ -z "${_val}" ] && _val="-"

		if [ -z "${_status}" ]; then
			_status="${N0_COLOR}${_val}"
		else
			_status="${_status} ${_val}"
		fi
	done
}

show_jaildata_from_sql()
{
	local _i

	if [ -n "${1}" ]; then
		sqlfile="$1"
	else
		sqlfile="local"
	fi

	[ -n "${2}" ] && jname="${2}"

	_status=
	_sql="SELECT id,jname,nic_order,nic_driver,nic_slot,nic_type,nic_parent,nic_hwaddr,nic_address,nic_mtu,nic_persistent,nic_ratelimit,nic_flags,nic_vlan_untagged,nic_vlan_tagged FROM bhyvenic WHERE jname='${jname}'"
	cbsdsqlro ${sqlfile} ${_sql} | while read id jname nic_order nic_driver nic_slot nic_type nic_parent nic_hwaddr nic_address nic_mtu nic_persistent nic_ratelimit nic_flags nic_vlan_untagged nic_vlan_tagged; do
		populate_output_data
		printf "${N2_COLOR}"
		printf "${_status}"
		printf "${N0_COLOR}\n"
	done
}

validate_local_vm()
{
	[ -z "${jname}" ] && err 1 "${N1_COLOR}bhyve-nic: ${N2_COLOR}jname=${N1_COLOR} is required${N0_COLOR}"
	cbsdsqlro_vars local "SELECT emulator,jid FROM jails WHERE jname='${jname}'" _emulator _jid
	[ -z "${_emulator}" ] && err 1 "${N1_COLOR}bhyve-nic: no such local VM: ${N2_COLOR}${jname}${N0_COLOR}"
	[ "${_emulator}" != "bhyve" ] && err 1 "${N1_COLOR}bhyve-nic: ${N2_COLOR}${jname}${N1_COLOR} is not a bhyve VM${N0_COLOR}"
	mysqlite="${jailsysdir}/${jname}/local.sqlite"
	[ ! -r "${mysqlite}" ] && err 1 "${N1_COLOR}bhyve-nic: database is not readable: ${N2_COLOR}${mysqlite}${N0_COLOR}"
}

validate_nic_id()
{
	case "${id}" in
		""|*[!0-9]*) err 1 "${N1_COLOR}bhyve-nic: numeric ${N2_COLOR}id=${N1_COLOR} is required${N0_COLOR}" ;;
	esac
	cbsdsqlro_vars "${mysqlite}" "SELECT COUNT(*) FROM bhyvenic WHERE id='${id}' AND jname='${jname}'" _exists
	[ "${_exists}" = "0" ] && err 1 "${N1_COLOR}bhyve-nic: NIC id ${N2_COLOR}${id}${N1_COLOR} not found for ${N2_COLOR}${jname}${N0_COLOR}"
}

warn_running_vm()
{
	[ -n "${_jid}" -a "${_jid}" != "0" ] && \
		${ECHO} "${N1_COLOR}Note: VM is running, ${N2_COLOR}cbsd brestart ${jname}${N1_COLOR} is required to apply changes${N0_COLOR}"
}

bhyvenic_add()
{
	local _new_id=

	[ -z "${order}" ] && order="0"
	[ -z "${driver}" ] && driver="vtnet"
	[ -z "${slot}" ] && slot="0"
	[ -z "${type}" ] && type="0"
	[ -z "${interface}" ] && interface="auto"
	[ -z "${hwaddr}" ] && hwaddr="0"
	[ -z "${address}" ] && address="0"
	[ -z "${mtu}" ] && mtu="0"
	[ -z "${persistent}" ] && persistent="0"
	[ -z "${ratelimit}" ] && ratelimit="0"
	[ -z "${flags}" ] && flags="0"
	[ -z "${vlan_untagged}" ] && vlan_untagged="0"
	[ -z "${vlan_tagged}" ] && vlan_tagged="0"

	cbsdsqlrw "${mysqlite}" "INSERT INTO bhyvenic (jname,nic_order,nic_driver,nic_slot,nic_type,nic_parent,nic_hwaddr,nic_address,nic_mtu,nic_persistent,nic_ratelimit,nic_flags,nic_vlan_untagged,nic_vlan_tagged) VALUES ('${jname}','${order}','${driver}','${slot}','${type}','${interface}','${hwaddr}','${address}','${mtu}','${persistent}','${ratelimit}','${flags}','${vlan_untagged}','${vlan_tagged}')"
	cbsdsqlro_vars "${mysqlite}" "SELECT MAX(id) FROM bhyvenic WHERE jname='${jname}'" _new_id
	${ECHO} "${N1_COLOR}NIC id ${N2_COLOR}${_new_id}${N1_COLOR} added to ${N2_COLOR}${jname}${N0_COLOR}"
	warn_running_vm
}

bhyvenic_update()
{
	local _column= _field= _sql= _updated= _value=

	for _field in order driver slot type interface hwaddr address mtu persistent ratelimit flags vlan_untagged vlan_tagged; do
		eval _value=\$${_field}
		[ -z "${_value}" ] && continue
		case "${_field}" in
			order) _column="nic_order" ;;
			driver) _column="nic_driver" ;;
			slot) _column="nic_slot" ;;
			type) _column="nic_type" ;;
			interface) _column="nic_parent" ;;
			hwaddr) _column="nic_hwaddr" ;;
			address) _column="nic_address" ;;
			mtu) _column="nic_mtu" ;;
			persistent) _column="nic_persistent" ;;
			ratelimit) _column="nic_ratelimit" ;;
			flags) _column="nic_flags" ;;
			vlan_untagged) _column="nic_vlan_untagged" ;;
			vlan_tagged) _column="nic_vlan_tagged" ;;
		esac
		_sql="${_sql}; UPDATE bhyvenic SET ${_column}='${_value}' WHERE id='${id}' AND jname='${jname}'"
		_updated="${_updated} ${_field}=${_value}"
	done

	if [ -n "${_sql}" ]; then
		cbsdsqlrw "${mysqlite}" "${_sql}"
		${ECHO} "${N1_COLOR}NIC id ${N2_COLOR}${id}${N1_COLOR} updated:${N2_COLOR}${_updated}${N0_COLOR}"
		warn_running_vm
	else
		${ECHO} "${N1_COLOR}No parameters specified to update${N0_COLOR}"
	fi
}

bhyvenic_delete()
{
	cbsdsqlrw "${mysqlite}" "DELETE FROM bhyvenic WHERE id='${id}' AND jname='${jname}'"
	${ECHO} "${N1_COLOR}NIC id ${N2_COLOR}${id}${N1_COLOR} deleted from ${N2_COLOR}${jname}${N0_COLOR}"
	warn_running_vm
}

show_remote()
{
	show_header

	[ -z "${node}" ] && capture node cbsd node mode=list header=0 allinfo=0

	for _n in $node; do
		nodename="${_n}"
		show_jaildata_from_sql "inv.${_n}"
	done
}

show_local()
{
	local _errcode _status _vm _lvm

	show_header

	for _vm in ${vms}; do
		_lvm="${jailsysdir}/${_vm}/local.sqlite"
		[ -r "${_lvm}" ] && show_jaildata_from_sql "${_lvm}" "${_vm}"
	done
}

show_nic()
{
	if [ -n "${node}" ]; then
		show_remote
		exit
	fi

	if [ -n "${alljails}" ]; then
		show_local
		header=0
		show_remote
	else
		show_local
	fi
}

vm_list()
{
	if [ -n "${jname}" ]; then
		vms="${jname}"
	else
		capture vms cbsdsqlro local "SELECT jname FROM jails WHERE emulator = 'bhyve'"
	fi
}

vms=
[ -z "${header}" ] && header=1
sqldelimer=" "

#### MAIN
case "${mode}" in
	list)
		vm_list
		show_nic | ${COLUMN_CMD} -t
		;;
	add)
		validate_local_vm
		bhyvenic_add
		;;
	update)
		validate_local_vm
		validate_nic_id
		bhyvenic_update
		;;
	delete)
		validate_local_vm
		validate_nic_id
		bhyvenic_delete
		;;
	*)
		err 1 "${N1_COLOR}bhyve-nic: unknown mode: ${N2_COLOR}${mode}${N1_COLOR}. Use: list, add, update, delete${N0_COLOR}"
		;;
esac

exit 0
