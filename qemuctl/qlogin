#!/usr/bin/env cbsd
#v13.0.2
CIXARG=""
CIXOPTARG="jname remote inter"
MYDESC="Exec login into QEMU domain"
ADDHELP="\
  If you are in the CBSDfile directory, these environments will always have priority\n\
"
EXTHELP="wf_qlogin"
CBSDMODULE="qemu"

. ${subrdir}/nc.subr
. ${strings}
. ${tools}
cixinit

try_remote()
{
	local RHST

	. ${subrdir}/rrcconf.subr
	. ${subrdir}/jcreate.subr	# for export_qemu_data_for_external_hook
	export_qemu_data_for_external_hook

	[ "${remote}" = "1" ] && err 1 "${N1_COLOR}No such domain${N0_COLOR}"
	RHST=$( bwhereis ${jname} | ${HEAD_CMD} -n1 )
	[ -z "${RHST}" ] && err 1 "No such domain for login"

	# we don't need for interactive when come with remote=2 from select_jail_by_list
	if [ "${remote}" != "2" -a "${always_rlogin}" = "0" ]; then
		getyesno "Found domain on remote node: ${RHST}. Try to login?"
		[ $? -eq 1 -o $? -eq 3 ] && err 1 "No such domains for login"
	fi

	case "${login_cmd}" in
		internal)
			echo "${N1_COLOR}Exec qlogin internal on remote node: ${N2_COLOR}${RHST}${N0_COLOR}"
			cbsdlogger NOTICE ${CIX_APP}: executing internal qlogin: rexe node=${RHST} /usr/local/bin/cbsd qlogin src_session=${nodename} jname=${jname} remote=1
			rexe node=${RHST} /usr/local/bin/cbsd qlogin src_session=${nodename} jname=${jname} remote=1
			;;
		*)
			# re-read custom
			readconf qlogin.conf > /dev/null 2>&1
			cbsdlogger NOTICE ${CIX_APP}: executing custom qlogin: ${login_cmd}
			login_custom
			;;
	esac
	err 0 ""
}

login_internal()
{
	local CBSDPATH="${PATH}"

	# reset CBSD PATH
	export PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"
	local TMUX_CMD=$( which tmux )

	[ -z "${TMUX_CMD}" ] && err 1 "${N1_COLOR}no such tmux${N0_COLOR}"

	if [ "${vm_efi}" != "none" ]; then
		if [ -f "${jailsysdir}/${jname}/vnc_port" ]; then
			echo " *** VM booted in VNC mode. ***"
			echo "${N1_COLOR}For attach VM console, use: ${N2_COLOR}vncviewer ${qemu_vnc_tcp_ipconnect}:${vm_port}${N0_COLOR}"
			if ! getyesno "Do you want to attach into UEFI console anyway?"; then
				exit 0
			fi
		else
			echo " *** VM booted in VNC mode. ***"
			echo "But no ${jailsysdir}/${jname}/vnc_port file"
			if ! getyesno "Do you want to attach into UEFI console anyway?"; then
				exit 0
			fi
		fi
	fi

	export TERM=xterm
	${TMUX_CMD} -Lcbsd-"${jname}" attach-session
}

login_custom()
{
	local CBSDPATH="${PATH}"
	# reset CBSD PATH
	export PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"
	. ${subrdir}/jcreate.subr	# for export_qemu_data_for_external_hook
	export_qemu_data_for_external_hook

	# re-read custom
	readconf qlogin.conf > /dev/null 2>&1

	echo "${N1_COLOR}Custom login command: ${N2_COLOR}${login_cmd}${N0_COLOR}"
	exec /bin/sh -c "${login_cmd}"
	# restore CBSD PATH
	export PATH="${CBSDPATH}"
}

# jname must be set
jname_qlogin()
{
	. ${subrdir}/rcconf.subr
	[ $? -eq 1 ] && try_remote

	[ "${emulator}" != "qemu" ] && err 1 "${N1_COLOR}Not in qemu mode${N0_COLOR}"
	[ "${baserw}" = "1" ] && path=${data}
	[ ${jid} -eq 0 ] && err 1 "Not running"

	readconf qlogin.conf

	vm_efi=$( cbsdsqlro local "SELECT vm_efi FROM qemu WHERE jname=\"${jname}\"" )
	vnc_bind=$( cbsdsqlro local "SELECT qemu_vnc_tcp_bind FROM qemu WHERE jname=\"${jname}\"" )

	if [ "${vm_efi}" != "none" ]; then
		if [ -f "${jailsysdir}/${jname}/vnc_port" ]; then
			vm_port=$( ${CAT_CMD} ${jailsysdir}/${jname}/vnc_port )
		else
			vm_port="0"
		fi
	fi

	cbsdlogger NOTICE ${CIX_APP}: login into ${jname} via ${login_cmd} method

	case "${login_cmd}" in
		internal)
			login_internal
			;;
		*)
			login_custom
			;;
	esac
}


# check for cloud function when CBSDfile exist
Makefile="${CIX_PWD}/CBSDfile"
if [ -r "${Makefile}" ]; then
	[ -z "${CBSDFILE_RECURSIVE}" ] && echo "${N1_COLOR}found CBSDfile: ${N2_COLOR}${Makefile}${N0_COLOR}"
	. ${Makefile}

	all_qemu_list=$( ${GREP_CMD} -E '^qemu_[a-zA-Z0-9_@%:][-a-zA-Z0-9_@%:]*\(\)$' ${Makefile} | ${XARGS_CMD} | ${TR_CMD} -d "()" | ${SED_CMD} s#qemu_##g )
	[ -z "${all_qemu_list}" ] && err 1 "${N1_COLOR}${CIX_APP}: no qemu found${N0_COLOR}"
	[ -z "${jname}" ] && jname="$1"

	if [ -n "${jname}" ]; then
		found=0
		for i in ${all_qemu_list}; do
			if [ "${i}" = "${jname}" ]; then
				found=1
				break
			fi
		done
		[ ${found} -eq 0 ] && err 1 "${N1_COLOR}${CIX_APP}: no such qemu: ${N2_COLOR}${jname}${N0_COLOR}"
		all_qemu_list="${jname}"
	fi

	all_qemu_list_num=0
	for i in ${all_qemu_list}; do
		all_qemu_list_num=$(( all_qemu_list_num + 1 ))
	done

	if [ -n "${CLOUD_URL}" -a -n "${CLOUD_KEY}" ]; then
		cbsd_api=1
	else
		# CBSDfile without API
		if [ ${all_qemu_list_num} -gt 1 ]; then
			# select jails from CBSDfile scope
			jname=
			select_jail_by_list -s "List of online jails limited by CBSDfile scope [${all_qemu_list}]:" -l "${all_qemu_list}" -r 0 -e qls
			if [ -n "${jname}" ]; then
				echo "${N1_COLOR}exec qlogin to: ${N2_COLOR}${jname}${N0_COLOR}" 1>&2
				jname_qlogin
			fi
		else
			jname="${all_qemu_list}"
			echo "${N1_COLOR}exec qlogin to: ${N2_COLOR}${jname}${N0_COLOR}" 1>&2
			jname_qlogin
		fi
		exit 0
	fi
else
	cbsd_api=0
fi

if [ ${cbsd_api} -eq 1 ]; then
	capture CURL_CMD which curl
	[ -z "${CURL_CMD}" ] && err 1 "${N1_COLOR}cloud up requires curl, please install: ${N2_COLOR}pkg install -y curl${N0_COLOR}"
	[ -z "${CBSDFILE_RECURSIVE}" ] && echo "${N1_COLOR}main cloud api: ${N2_COLOR}${CLOUD_URL}${N0_COLOR}" 1>&2
	capture _cid ${miscdir}/cbsd_md5 "${CLOUD_KEY}"

	for jname in ${all_qemu_list}; do
		[ -z "${jname}" ] && continue
		_ssh=$( ${CURL_CMD} --no-progress-meter -H "cid:${_cid}" ${CLOUD_URL}/api/v1/status/${jname} 2>&1 )
		_ret=$?
		if [ ${_ret} -ne 0 ]; then
			echo "${N1_COLOR}${CIX_APP} error: curl error: ${N2_COLOR}${_ssh}${N0_COLOR}"
			echo "${CURL_CMD} --no-progress-meter -H \"cid:XXXXX\" ${CLOUD_URL}/api/v1/status/${jname}"
			continue
		fi
		_ssh_string=$( echo "${_ssh}" | ${JQ_CMD} '.ssh_string' | ${TR_CMD} -d '"' )
		case "${_ssh_string}" in
			ssh\ *)
				_ssh_post=${_ssh_string#ssh }
				;;
			*)
				echo "${N1_COLOR}${CIX_APP} error: curl error2: ${N2_COLOR}${_ssh}${N0_COLOR}"
				echo "${CURL_CMD} --no-progress-meter -H \"cid:XXXXX\" ${CLOUD_URL}/api/v1/status/${jname}"
				continue
				;;
		esac
		_ssh_ip=$( echo ${_ssh_post} | ${AWK_CMD} '{printf $1}' )
		_ssh_port=$( echo ${_ssh_post} | ${AWK_CMD} '{printf $2}' | ${TR_CMD} -d '\-p' )

		if [ -n "${SUDO_USER}" ]; then
			if [ -r /home/${SUDO_USER}/.ssh/id_ed25519 ]; then
				_ssh_sudo_arg="-oIdentityFile=/home/${SUDO_USER}/.ssh/id_ed25519"
			elif [ -r /home/${SUDO_USER}/.ssh/id_rsa ]; then
				_ssh_sudo_arg="-oIdentityFile=/home/${SUDO_USER}/.ssh/id_rsa"
			fi
		fi
		jexec_cmd="${SSH_CMD} -tt -oStrictHostKeyChecking=no -oConnectTimeout=5 -oServerAliveInterval=10 ${_ssh_sudo_arg} ${_ssh_post}"
		${jexec_cmd}
	done
	exit 0
fi

emulator="qemu"
jname_is_multiple

if [ -n "${jail_list}" ]; then
	echo "${N1_COLOR}Found domains by mask: ${N2_COLOR}${jail_list}${N0_COLOR}"
	for jname in ${jail_list}; do
		echo "${N1_COLOR}exec qlogin to: ${N2_COLOR}${jname}${N0_COLOR}"
		qlogin jname=${jname}
	done
	exit 0
fi

[ -z "${jname}" ] && jname=$1
[ -z "${jname}" ] && select_jail_by_list -s "List of online domains" -a "On" -e qls -r ${sqlreplica}
[ -z "${jname}" ] && err 1 "${N1_COLOR}Please specify jname as argument${N0_COLOR}"
[ -z "${remote}" ] && remote=0

jname_qlogin

exit 0
